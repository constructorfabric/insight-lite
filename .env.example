# copy to .env (gitignored) and fill in
GH_TOKEN=ghp_your_token_here

# Portal login. Leave PORTAL_PASSWORD empty to run without auth (only safe on
# localhost or behind an authenticating reverse proxy). Set it to require HTTP
# Basic auth on every request; PORTAL_USER defaults to "insight".
PORTAL_USER=insight
PORTAL_PASSWORD=

# MCP server bearer token. Set it so MCP clients must send
# `Authorization: Bearer <token>`; empty = unauthenticated (localhost/proxy only).
MCP_TOKEN=

# ---- Metrics assistant (chat_agent.py + POST /api/chat) ----
# Gemini answers questions about the report by calling the read-only data tools.
# Google AI Studio key (default access path); empty = the chat panel returns an
# error frame instead of answering.
GEMINI_API_KEY=
# Model id. Any Gemini model with function-calling; flash is cheap + fast.
GEMINI_MODEL=gemini-2.5-flash
# Optional cost accounting for Usage insights: price per 1M tokens (USD), model-specific.
# Set both to your plan's rates; leave empty to track tokens only (cost shows "n/a").
# Cost is never guessed — it's computed only from these values.
GEMINI_PRICE_IN_PER_M=
GEMINI_PRICE_OUT_PER_M=
# Explicit context caching for the stable system+tools prefix (~1.7k tokens re-sent
# each turn). TTL in seconds; empty/0 = off. It bills that prefix at the cache-read
# rate below but adds a storage charge ($/token/hour), so it only pays off above
# ~40-50 questions/day — leave off for low traffic. Set the cache-read price to
# enable accurate cost accounting for cached tokens (else they bill at the input rate).
GEMINI_CACHE_TTL=
GEMINI_PRICE_CACHED_PER_M=
# Assistant transcript retention in days. The chat conversation (clean question +
# answer text) is stored in the DB for review. Empty/0 = keep forever; set e.g. 90 to
# auto-prune older conversations after each turn.
CHAT_HISTORY_DAYS=
# Use Vertex AI instead of AI Studio: set to 1 and provide project/location
# (auth via Application Default Credentials, no GEMINI_API_KEY needed).
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ---- GitHub-OAuth gate (compose profile "oauth") — see deploy/oauth/README.md ----
# Only needed if you front the portal with oauth2-proxy to let in org members and
# refuse everyone else. All optional; leave blank to keep the plain basic-auth setup.
OAUTH_GITHUB_ORG=            # GitHub org whose members are allowed (e.g. your-org)
OAUTH_CLIENT_ID=             # from the GitHub OAuth App
OAUTH_CLIENT_SECRET=         # from the GitHub OAuth App
OAUTH_COOKIE_SECRET=         # 32-byte base64: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
OAUTH_REDIRECT_URL=https://insight.example.com/oauth2/callback
# Break-glass basic-auth fallback (optional): path inside the container to an
# htpasswd file (bcrypt). Create deploy/oauth/htpasswd, then set this to
# /etc/oauth2-proxy/htpasswd. Empty = no basic-auth fallback.
OAUTH_HTPASSWD_FILE=
# Branded sign-in/error pages ship in deploy/oauth/. Set this to "" (empty) to fall
# back to oauth2-proxy's built-in pages if a template ever misbehaves. Unset = branded.
# OAUTH_TEMPLATES_DIR=

# ---- Refresh alerting (alert.py, called from cron.d/insight-report) ----
# Where a failed or stalled refresh reports itself. Any endpoint that accepts
# {"text": "…"} — a Slack or Mattermost incoming webhook does. Leave blank and the
# alert still reaches the log and the exit code, but nobody's screen: that is exactly
# how a dead collector went unnoticed for ten days in July 2026.
# NOTE: compose loads this file at container CREATE, so after editing run
#   docker compose up -d report      (a plain `restart` will NOT pick it up)
ALERT_WEBHOOK_URL=
# Names the environment in the alert text. Unset falls back to the hostname, which
# inside a container is its id — useless in a message. Set something like "prod".
ALERT_LABEL=
# How stale the newest run may be before /health/data answers 503 and alert.py check
# fires. Default 36h: the nightly run makes ~24h normal, leaving room for one late run.
HEALTH_MAX_AGE_HOURS=
