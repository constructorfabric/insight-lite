<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title|e }} — Constructor Insight</title>
<style>
  {{ base_css|safe }}
  {{ shell_css|safe }}
  {{ chart_css|safe }}
  *{box-sizing:border-box}
  main.wrap{padding:24px 28px 56px}
  @media(max-width:900px){ main.wrap{padding:16px} }
  h1{font-size:22px;margin:0 0 8px}
  .ctrls{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:14px}
  .grid{display:grid;grid-template-columns:repeat(6,1fr);gap:14px}
  .cell{grid-column:span var(--w,2);background:var(--panel);border:1px solid var(--line);
    border-radius:var(--r-sm);padding:12px;min-height:80px;box-shadow:var(--sh)}
  .dp-err{color:var(--bad);font-size:12px}
</style></head><body>
<div class="app">
{{ sidebar|safe }}
<main class="wrap">
<h1>{{ title|e }}</h1>
<div class="ctrls">
  <select id="scope"><option value="">Whole org</option>{{ scope_options|safe }}</select>
  <select id="period">
    <option value="7d">7 days</option><option value="30d">30 days</option>
    <option value="90d">90 days</option><option value="365d">1 year</option>
    <option value="all" selected>All-time</option>
  </select>
</div>
<div class="grid" id="grid">
{% for p in panels %}<div class="cell" data-panel="{{ p.id|e }}" style="--w:{{ p.get('width', 2) }}"><h3 style="margin:0 0 8px;font-size:13px">{{ p.get('title','')|e }}</h3><div class="body"></div></div>
{% endfor %}
</div>
</main>
</div>
{{ vega_scripts|safe }}
<script>
var DID = {{ id|tojson }};
function hydrateVega(root){
  (root || document).querySelectorAll('.vl-panel').forEach(function(el){
    if (el.dataset.done) return;
    var s = el.querySelector('script.vl-spec');
    if (!s || !window.vegaEmbed) return;
    var spec;
    try { spec = JSON.parse(s.textContent); } catch(e){ return; }
    function tryEmbed(){
      if (el.dataset.done) return true;
      if (!el.clientWidth) return false;   // not laid out yet (e.g. hidden) — wait for width
      el.dataset.done = "1";
      vegaEmbed(el, spec, {actions:false, renderer:'svg', tooltip:true})
        .catch(function(){ el.innerHTML = '<div class="dp-err">chart failed</div>'; });
      return true;
    }
    if (!tryEmbed() && window.ResizeObserver){
      var ro = new ResizeObserver(function(){ if (tryEmbed()) ro.disconnect(); });
      ro.observe(el);
    }
  });
}
function load(){
  var scope=document.getElementById('scope').value, period=document.getElementById('period').value;
  document.querySelectorAll('.cell').forEach(function(c){
    var pid=c.getAttribute('data-panel'), body=c.querySelector('.body');
    fetch('/api/dashboard/panel?id='+encodeURIComponent(DID)+'&panel='+encodeURIComponent(pid)
      +'&scope='+encodeURIComponent(scope)+'&period='+encodeURIComponent(period))
      .then(function(r){return r.text();}).then(function(h){body.innerHTML=h;hydrateVega(body);})
      .catch(function(){body.innerHTML='<div class="dp-err">failed</div>';});
  });
}
document.getElementById('scope').addEventListener('change', load);
document.getElementById('period').addEventListener('change', load);
load();
</script>
</body></html>
