{% macro dpct(v) %}{% if v is not none %}{{ v|pct }}%{% else %}—{% endif %}{% endmacro %}
{% macro dnum(v, suffix='') %}{% if v is not none %}{{v}}{{suffix}}{% else %}—{% endif %}{% endmacro %}

{% macro panel_delivery_kpis(pr) %}
{% set d = pr.delivery or {} %}{% set dl = d.deltas or {} %}{% set sp = d.spark or {} %}
<div class="kpis">
  {{ kpi_tile((d.get('issues_total') or 0)|num, 'issues opened', 'in period', delta=dl.issues_total, spark=sp.issues_total_pts, drill=({'drill':'issue'} if d.get('issues_total') else none)) }}
  {{ kpi_tile(dpct(d.get('issue_close_rate')), 'close rate', (d.get('issues_closed') or 0) ~ ' closed', delta=dl.issue_close_rate, spark=sp.issue_close_rate_pts) }}
  {{ kpi_tile(dpct(d.get('defect_rate')), 'defect rate', 'bug category', delta=dl.defect_rate, lower_better=true, spark=sp.defect_rate_pts, spark_color='var(--c-bug)', drill=({'drill':'issue','category':'bug'} if d.get('defect_rate') else none)) }}
  {{ kpi_tile(((d.get('issue_median_time_to_close_days')|pct ~ 'd') if d.get('issue_median_time_to_close_days') is not none else '—'), 'median time-to-close', 'closed issues', delta=dl.issue_median_time_to_close_days, lower_better=true, spark=sp.issue_median_time_to_close_days_pts) }}
</div>
{% endmacro %}

{% macro panel_delivery_ci(pr) %}
{% set d = pr.delivery or {} %}{% set dl = d.deltas or {} %}{% set sp = d.spark or {} %}
<div class="kpis">
  {{ kpi_tile(dpct(d.get('ci_pass_rate')), 'CI pass rate', (d.get('ci_gate_runs') or 0) ~ ' gate runs', delta=dl.ci_pass_rate, spark=sp.ci_pass_rate_pts, spark_color='var(--good)', drill=({'drill':'ci'} if d.get('ci_gate_runs') else none)) }}
  {{ kpi_tile(((d.get('ci_median_duration_s')|dur) if d.get('ci_median_duration_s') is not none else '—'), 'CI median duration', 'gate workflows', delta=dl.ci_median_duration_s, lower_better=true, spark=sp.ci_median_duration_s_pts, spark_color='var(--good)', drill=({'drill':'ci'} if d.get('ci_gate_runs') else none)) }}
</div>
{% endmacro %}

{% macro panel_delivery_pr(pr) %}
{% set d = pr.delivery or {} %}{% set ma = d.get('pr_median_additions') %}{% set dl = d.deltas or {} %}{% set sp = d.spark or {} %}
<div class="kpis">
  {{ kpi_tile((d.get('prs_total') or 0)|num, 'PRs opened', 'in period', delta=dl.prs_total, spark=sp.prs_total_pts, spark_color='var(--c-pr)', drill=({'drill':'pr'} if d.get('prs_total') else none)) }}
  {{ kpi_tile(dpct(d.get('pr_merge_rate')), 'merge rate', 'merged / opened', delta=dl.pr_merge_rate, spark=sp.pr_merge_rate_pts, spark_color='var(--c-pr)', drill=({'drill':'pr','pr-state':'merged'} if d.get('pr_merge_rate') else none)) }}
  {{ kpi_tile(dpct(d.get('pr_abandon_rate')), 'abandoned', 'closed unmerged', delta=dl.pr_abandon_rate, lower_better=true, spark=sp.pr_abandon_rate_pts, spark_color='var(--c-bug)', drill=({'drill':'pr','pr-state':'abandoned'} if d.get('pr_abandon_rate') else none)) }}
  {{ kpi_tile(((ma|compact) if ma is not none else '—'), 'median PR size', dnum(d.get('pr_median_changed_files'), ' files'), delta=dl.pr_median_additions, lower_better=true, spark=sp.pr_median_additions_pts, spark_color='var(--c-pr)', drill=({'drill':'pr','tip':'the PRs opened in the window this median is taken over'} if ma is not none else none)) }}
  {{ kpi_tile(dpct(d.get('pr_reviewed_rate')), 'reviewed', '≥1 review', delta=dl.pr_reviewed_rate, spark=sp.pr_reviewed_rate_pts, spark_color='var(--c-pr)', drill=({'drill':'pr','reviewed':'1'} if d.get('pr_reviewed_rate') else none)) }}
  {{ kpi_tile(((d.get('pr_time_to_first_review_h')|hours) if d.get('pr_time_to_first_review_h') is not none else '—'), 'time to first review', 'reviewer response', delta=dl.pr_time_to_first_review_h, lower_better=true, spark=sp.pr_time_to_first_review_h_pts, spark_color='var(--c-spec)', drill={'tip':'from review requested (else opened) to the first review submitted; median over reviewed PRs'}) }}
  {{ kpi_tile((d.get('pr_reverts') or 0), 'reverts', 'instability signal', delta=dl.pr_reverts, lower_better=true, spark=sp.pr_reverts_pts, spark_color='var(--c-bug)', drill=({'drill':'pr','flag':'is_revert'} if d.get('pr_reverts') else none)) }}
</div>
{% endmacro %}

{% macro panel_delivery_mix(pr) %}
{% set d = pr.delivery or {} %}{% set mix = d.issues_by_category or {} %}{% set tot = d.issues_total or 0 %}
{% set rows = [] %}
{% for cat, n in mix.items() %}
{% set _ = rows.append({'label': cat, 'value': n, 'pct': (n / tot * 100) if tot else 0,
                        'drill': {'drill': 'issue', 'category': cat}}) %}
{% endfor %}
{{ cat_table(rows, value_head='Issues', share_tip='share of issues opened in the period',
             empty='No issues opened in this period.') }}
{% endmacro %}

{% macro panel_delivery_flow(pr) %}
{% set d = pr.delivery or {} %}{% set st = d.flow_stages or [] %}{% set tot = d.flow_total or 0 %}
{% if tot %}
{% set mx = (st|map(attribute='count')|max) or 1 %}
<div class="flowpipe">
  {% for s in st %}
    {% if not loop.first %}<div class="flow-arrow">&rarr;</div>{% endif %}
    <div class="flow-stage{% if not s.count %} zero{% endif %}"{% if s.count %} data-drill="flow" data-stage="{{ s.key }}" data-tip="{{ s.name }}: {{ s.count }} of {{ tot }} ({{ (100*s.count/tot)|round }}%) — click for the items"{% endif %}>
      <div class="flow-head"><span class="dot" style="background:{{ s.color }}"></span>{{ s.name }}</div>
      <div class="flow-n num">{{ s.count|num }}</div>
      <div class="flow-pct">{{ (100*s.count/tot)|round }}%</div>
      <div class="flow-bar"><i style="width:{{ (100*s.count/mx)|round(1) }}%;background:{{ s.color }}"></i></div>
    </div>
  {% endfor %}
</div>
<p class="conc" style="margin:12px 0 0">Current board state — the latest Projects&nbsp;v2 status of each work item, mapped to a
  stage via the <a href="/semantic">Taxonomy</a>. Not window-scoped (status history isn't in GitHub's API).{% if d.flow_unmapped %}
  {{ d.flow_unmapped|num }} item(s) sit in a status not yet mapped to a stage — refine the mapping to place them.{% endif %}</p>
{% else %}<p class="hint">No Projects&nbsp;v2 board statuses collected yet.</p>{% endif %}
{% endmacro %}

{% macro panel_cfd(c) %}
{% set c = c or {} %}
{% if not c.has_data %}
<p class="hint">The board-flow chart needs at least two daily snapshots{% if c.first_date %} — {{ c.n_dates }} captured so far, since {{ c.first_date }}{% endif %}. It fills in as snapshots accumulate.</p>
{% else %}
<div class="arealeg" style="margin-bottom:8px">{% for s in c.series %}<span class="lg"><i style="background:{{ s.color }}"></i>{{ s.name }}</span>{% endfor %}</div>
<div class="areawrap">{{ stacked_area(c.series, c.dates, c.series, 'items', 'items') }}</div>
<p class="conc">Cumulative flow of board items by stage, from daily snapshots since {{ c.first_date }} ({{ c.n_dates }} days). A widening upper band = growing WIP / backlog; a fattening QA band = a testing bottleneck; a steadily rising base = throughput to Done. Forward-only and sampled once a day — GitHub keeps no board status history. Depends on the Status&nbsp;→&nbsp;stage mapping in the <a href="/semantic">Taxonomy</a>.</p>
{% endif %}
{% endmacro %}

{% macro panel_dwell(dw) %}
{% set dw = dw or {} %}
{% if not dw.has_data %}
<p class="hint">No board timing yet — this reads each item's last-update time, captured from the next collection onward{% if dw.first_date %} (snapshot history since {{ dw.first_date }}){% endif %}.</p>
{% else %}
<div class="flow-cards" style="margin-bottom:12px">
  {% if dw.age_median_h is not none %}<div class="fcard"><div class="fc-n">{{ dw.age_median_h|hours }}</div><div class="fc-l">median age in current stage</div><div class="fc-s">{{ dw.age_n|num }} items waiting now</div></div>{% endif %}
  {% if dw.age_max_h is not none %}<div class="fcard"><div class="fc-n">{{ dw.age_max_h|hours }}</div><div class="fc-l">longest waiting</div><div class="fc-s">oldest item in a stage</div></div>{% endif %}
  {% if dw.dwell_median_h is not none %}<div class="fcard"><div class="fc-n">{{ dw.dwell_median_h|hours }}</div><div class="fc-l">median completed dwell</div><div class="fc-s">{{ dw.dwell_n|num }} observed moves</div></div>{% endif %}
</div>
<table class="grouped" style="width:100%">
  <thead><tr><th>Stage</th><th class="num" data-tip="items in this stage as of the latest snapshot">Now</th><th class="num" data-tip="median time current items have sat in this stage (now − last update)">Median age</th><th class="num" data-tip="median time items historically spent here before moving on">Median dwell</th><th class="num" data-tip="observed moves out of this stage">Moves</th></tr></thead>
  <tbody>
  {% for s in dw.stages %}
  <tr>
    <td><span class="dwdot" style="background:{{ s.color }}"></span>{{ s.name }}</td>
    <td class="num">{% if s.n_current %}{{ s.n_current|num }}{% else %}<span style="color:var(--mut)">—</span>{% endif %}</td>
    <td class="num">{% if s.age_median_h is not none %}{{ s.age_median_h|hours }}{% else %}<span style="color:var(--mut)">—</span>{% endif %}</td>
    <td class="num">{% if s.median_h is not none %}{{ s.median_h|hours }}{% else %}<span style="color:var(--mut)">—</span>{% endif %}</td>
    <td class="num">{{ s.n|num }}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
<p class="conc"><b>Age</b> — how long current items have sat in their stage (latest snapshot − item's last update); available now, no history needed. <b>Dwell</b> — how long items historically spent in a stage before moving on, from snapshot diffs. Both time transitions by each item's update time (≈ the actual move); it's a close estimate since an update can be any edit, not strictly a status change. Terminal stages are excluded from age.</p>
{% endif %}
{% endmacro %}

{% macro panel_rewinds(rw) %}
{% set rw = rw or {} %}
{% if not rw.has_history %}
<p class="hint">Needs at least two board snapshots to see movement — only {{ rw.n_dates or 0 }} captured so far{% if rw.first_date %} (since {{ rw.first_date }}){% endif %}. Fills in as snapshots accumulate.</p>
{% elif not rw.events %}
<p class="conc">No items were sent back from QA to development in this period. Reconstructed from board snapshots since {{ rw.first_date }} — a same-day round-trip between snapshots can be missed.</p>
{% else %}
<div class="flow-cards">
  <div class="fcard fcard-drill" data-drill="rewinds" data-tip="Click for the list of items"><div class="fc-n">{{ rw.qa_to_dev|num }}</div><div class="fc-l">returned to dev from QA</div><div class="fc-s">across {{ rw.by_person|length }} owner(s) · click for the list</div></div>
</div>
<p class="conc">Items pushed backward on the board from testing to development (QA → In progress), reconstructed by diffing board snapshots since {{ rw.first_date }}. GitHub keeps no board status-change history, so we only see moves between snapshots — treat as a floor. Depends on the Status&nbsp;→&nbsp;stage mapping in the <a href="/semantic">Taxonomy</a>.</p>
{% endif %}
{% endmacro %}

