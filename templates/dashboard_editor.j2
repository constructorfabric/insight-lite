<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Edit: {{ title|e }} — Constructor Insight</title>
<style>
  {{ base_css|safe }}
  {{ shell_css|safe }}
  {{ chart_css|safe }}
  *{box-sizing:border-box}
  main.wrap{padding:24px 28px 56px}
  @media(max-width:900px){ main.wrap{padding:16px} }
  .row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  .top{justify-content:space-between;margin-bottom:18px}
  #dash-title{font-size:17px;font-weight:700;min-width:280px}
  .status{font-size:12px;min-width:5em}
  .status.ok{color:var(--good)}
  .status.err{color:var(--bad)}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);
    padding:18px;box-shadow:var(--sh);margin-bottom:18px}
  .card-head{display:flex;justify-content:space-between;align-items:center;margin:0 0 14px}
  .card-head h2{margin:0;font-size:13px;text-transform:uppercase;letter-spacing:.05em;color:var(--mut)}
  .panel-row{display:flex;gap:14px;align-items:flex-start;background:var(--panel);border:1px solid var(--line);
    border-radius:var(--r-sm);padding:12px 14px;margin-bottom:10px}
  .panel-row.drag-over{border-color:var(--acc);border-style:dashed}
  .handle{cursor:grab;color:var(--mut);padding:4px 2px;user-select:none;font-size:16px;line-height:1}
  .panel-meta{flex:0 0 240px}
  .panel-meta .t{font-weight:700;font-size:13.5px}
  .panel-meta .s{font-size:12px;color:var(--mut);margin-top:2px}
  .panel-ctrls{display:flex;flex-direction:column;gap:6px;flex:0 0 84px}
  .panel-ctrls label{font-size:10px;color:var(--mut);text-transform:uppercase;letter-spacing:.03em}
  .panel-ctrls input{width:100%}
  .preview{flex:1;min-width:0;border:1px dashed var(--line2);border-radius:var(--r-sm);
    padding:8px;min-height:60px;overflow:auto;font-size:12px}
  .dp-err{color:var(--bad);font-size:12px}
  .empty{color:var(--mut);font-size:13px;padding:10px 0}

  /* segmented control — same convention as the report's period presets */
  .pseg{display:inline-flex;border:1px solid var(--line2);border-radius:999px;background:var(--panel);
    padding:4px;gap:2px;box-shadow:var(--sh)}
  .pchip{border:none;background:transparent;color:var(--ink2);border-radius:999px;padding:6px 14px;
    font:inherit;font-size:13px;font-weight:600;cursor:pointer;box-shadow:none}
  .pchip:hover{background:var(--panel2);color:var(--ink)}
  .pchip.active{background:var(--acc);color:#fff;box-shadow:0 2px 8px rgba(91,91,240,.35)}

  /* viz-type selector (#wp-viz) — a wrapping row of pchip buttons with a glyph +
     label; incompatible types (see SHAPE_VIZ gating in the script) are disabled. */
  .viz-row{display:flex;flex-wrap:wrap;gap:6px}
  .viz-btn{display:inline-flex;align-items:center;gap:6px;padding:6px 12px}
  .viz-btn .vg{font-size:14px;line-height:1}
  .viz-btn .vl{font-size:12.5px}
  .viz-btn:disabled{opacity:.35;cursor:not-allowed;pointer-events:none;box-shadow:none}

  /* series/measures shelf (#wp-series) — chips for the chosen measures */
  .series-shelf{display:flex;flex-wrap:wrap;gap:6px;min-height:34px;padding:6px;
    border:1px dashed var(--line2);border-radius:var(--r-sm)}
  .chip{display:inline-flex;align-items:center;gap:4px;background:var(--panel2);
    border-radius:999px;padding:5px 4px 5px 12px;font-size:12.5px;font-weight:600;color:var(--ink)}
  .chip-x{border:none;background:transparent;color:var(--mut);cursor:pointer;box-shadow:none;
    font-size:15px;line-height:1;padding:0 6px;border-radius:999px}
  .chip-x:hover{background:var(--line2);color:var(--ink)}
  .wp-note{font-size:12px;color:var(--bad);margin:2px 0 0}
  .wp-row.disabled{opacity:.4;cursor:not-allowed}
  .wp-row.disabled:hover{background:transparent}

  /* widget picker modal — .dov/.dbox overlay convention (see usage insights page) */
  .dov{position:fixed;inset:0;background:rgba(0,0,0,.4);display:flex;align-items:flex-start;
    justify-content:center;padding:5vh 16px;z-index:200}
  .dov[hidden]{display:none}
  .dbox{background:var(--panel);border:1px solid var(--line);border-radius:12px;
    width:100%;max-width:860px;max-height:90vh;display:flex;flex-direction:column;
    box-shadow:0 14px 50px rgba(0,0,0,.3)}
  .dhead{display:flex;align-items:center;justify-content:space-between;gap:10px;
    padding:12px 16px;border-bottom:1px solid var(--line)}
  .dhead b{font-size:14.5px}
  .dhead button{border:none;background:transparent;font-size:20px;line-height:1;cursor:pointer;
    color:var(--mut);box-shadow:none;padding:2px 4px}
  .wp-body{display:flex;gap:0;min-height:0;flex:1}
  .wp-col{padding:14px 16px;overflow:auto}
  .wp-list{flex:1 1 46%;border-right:1px solid var(--line);min-width:0}
  .wp-detail{flex:1 1 54%;min-width:0;display:flex;flex-direction:column;gap:12px}
  #wp-search{width:100%;margin-bottom:10px}
  .wp-group{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;
    color:var(--mut);margin:14px 0 6px}
  .wp-group:first-child{margin-top:0}
  .wp-row{display:flex;align-items:center;gap:10px;padding:7px 8px;border-radius:8px;cursor:pointer}
  .wp-row:hover{background:var(--panel2)}
  .wp-row.sel{background:var(--panel2);box-shadow:inset 0 0 0 1px var(--acc)}
  .wp-row .wi{flex:none;width:22px;height:22px;border-radius:6px;background:var(--panel2);
    display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:var(--acc-ink)}
  .wp-row .wt{min-width:0;flex:1}
  .wp-row .wt .l{font-size:13.5px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .wp-row .wt .h{font-size:11.5px;color:var(--mut);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .wp-empty{color:var(--mut);font-size:13px;padding:10px 2px}
  .wp-field{display:flex;flex-direction:column;gap:5px}
  .wp-field label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;color:var(--mut)}
  .wp-field input,.wp-field select{width:100%}
  .wp-hint{font-size:12px;color:var(--mut);margin:-4px 0 0}
  details.wp-advanced{border:1px solid var(--line);border-radius:var(--r-sm);background:var(--bg)}
  details.wp-advanced summary{cursor:pointer;color:var(--acc-ink);font-weight:600;font-size:13px;
    padding:9px 12px;list-style:none}
  details.wp-advanced summary::-webkit-details-marker{display:none}
  details.wp-advanced summary::before{content:"\25B8 ";color:var(--acc)}
  details.wp-advanced[open] summary::before{content:"\25BE "}
  details.wp-advanced > div{padding:2px 12px 12px;display:flex;flex-direction:column;gap:10px}
  #wp-preview{border:1px dashed var(--line2);border-radius:var(--r-sm);padding:10px;
    min-height:70px;overflow:auto;font-size:12px}
  .dfoot{display:flex;align-items:center;justify-content:flex-end;gap:8px;
    padding:12px 16px;border-top:1px solid var(--line)}
  @media(max-width:760px){ .wp-body{flex-direction:column} .wp-list{border-right:none;border-bottom:1px solid var(--line)} }
</style></head>
<body>
<div class="app">
{{ sidebar|safe }}
<main class="wrap">

<div class="row top">
  <div class="row">
    <input id="dash-title" value="{{ title|e }}">
    <select id="dash-vis">
      <option value="private" {{ "selected" if visibility == "private" else "" }}>Private</option>
      <option value="shared" {{ "selected" if visibility == "shared" else "" }}>Shared</option>
    </select>
  </div>
  <div class="row">
    <span id="status" class="status"></span>
    <button id="save" class="primary" type="button">Save</button>
    <a href="/dashboard/{{ id }}">Open view &rarr;</a>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <h2>Panels</h2>
    <button id="open-picker" class="primary" type="button">+ Add widget</button>
  </div>
  <div id="panels"></div>
</div>

</main>
</div>

<div id="picker" class="dov" hidden aria-hidden="true">
  <div class="dbox">
    <div class="dhead"><b>Add widget</b><button id="picker-close" type="button" aria-label="Close">&times;</button></div>
    <div class="wp-body">
      <div class="wp-col wp-list">
        <input id="wp-search" type="text" placeholder="Search measures…">
        <div id="wp-measures"></div>
      </div>
      <div class="wp-col wp-detail">
        <div class="wp-field"><label>Show as</label><div id="wp-viz" class="viz-row"></div></div>
        <div class="wp-field"><label>Measures</label>
          <div id="wp-series" class="series-shelf"></div>
          <p id="wp-series-note" class="wp-note" hidden></p>
        </div>
        <div class="wp-field"><label>Title</label><input id="wp-title" placeholder="Panel title"></div>
        <div class="wp-field"><label>Width</label><input id="wp-width" type="number" min="1" max="6" value="2"></div>
        <details class="wp-advanced" id="wp-advanced">
          <summary>Advanced: raw tool &amp; field</summary>
          <div>
            <p class="wp-hint">Pick a tool, then a field — for anything not in the measure list on the left. Adds to the measures shelf above.</p>
            <div class="wp-field"><label>Tool</label><select id="wp-adv-tool"></select></div>
            <div class="wp-field"><label>Field</label>
              <select id="wp-adv-field-sel"></select>
              <input id="wp-adv-field" placeholder="custom field, e.g. totals.commits" hidden></div>
          </div>
        </details>
        <div class="wp-field"><label>Preview</label><div id="wp-preview"></div></div>
      </div>
    </div>
    <div class="dfoot">
      <button id="wp-cancel" type="button">Cancel</button>
      <button id="wp-add" class="primary" type="button" disabled>Add</button>
    </div>
  </div>
</div>

{{ vega_scripts|safe }}
<script>
var spec = {{ spec_json|safe }};
var panels = spec.panels || [];
var DID = {{ id|tojson }};

function hydrateVega(root){
  (root || document).querySelectorAll('.vl-panel').forEach(function(el){
    if (el.dataset.done) return;
    var s = el.querySelector('script.vl-spec');
    if (!s || !window.vegaEmbed) return;
    var spec;
    try { spec = JSON.parse(s.textContent); } catch(e){ return; }
    function tryEmbed(){
      if (el.dataset.done) return true;
      if (!el.clientWidth) return false;   // not laid out yet (e.g. hidden) — wait for width
      el.dataset.done = "1";
      vegaEmbed(el, spec, {actions:false, renderer:'svg', tooltip:true})
        .catch(function(){ el.innerHTML = '<div class="dp-err">chart failed</div>'; });
      return true;
    }
    if (!tryEmbed() && window.ResizeObserver){
      var ro = new ResizeObserver(function(){ if (tryEmbed()) ro.disconnect(); });
      ro.observe(el);
    }
  });
}

var counter = panels.length;
panels.forEach(function(p){
  var m = /(\d+)$/.exec((p && p.id) || "");
  if (m) counter = Math.max(counter, parseInt(m[1], 10));
});

var listEl = document.getElementById("panels");
var titleField = document.getElementById("dash-title");
var visField = document.getElementById("dash-vis");
var statusEl = document.getElementById("status");
var dragIndex = null;

// ---- widget picker modal ------------------------------------------------

// Icon per measure shape (left-list rows) — unrelated to the viz picker below.
var SHAPE_ICON = { scalar: "#", table: "▦", series: "∿" };

// viz-type catalog: glyph + label per display type, in the order shown in #wp-viz.
var VIZ_TYPES = [
  { viz: "number", glyph: "123", label: "Number" },
  { viz: "line",   glyph: "∿", label: "Line" },
  { viz: "area",   glyph: "◺", label: "Area" },
  { viz: "column", glyph: "▮", label: "Column" },
  { viz: "bar",    glyph: "▬", label: "Bar" },
  { viz: "pie",    glyph: "◔", label: "Pie" },
  { viz: "table",  glyph: "▦", label: "Table" }
];
// Mirrors dashboards._SHAPE_VIZ — which viz types a measure's binding shape allows.
// A viz can belong to more than one shape (e.g. scalars AND breakdowns both bar/
// column/pie/table), so there is no 1:1 viz->shape inverse — gating keys off shape.
var SHAPE_VIZ = { scalar: ["number", "column", "bar", "pie", "table"],
                  series: ["line", "area"],
                  table: ["bar", "column", "pie", "table"] };
// viz types that accept more than one measure. Only Number is single-measure.
var MULTI_FIELD_VIZ = ["line", "area", "column", "bar", "pie", "table"];
// Default viz auto-picked when the shelf's first measure sets its shape.
var DEFAULT_VIZ_FOR_SHAPE = { series: "line", table: "table", scalar: "number" };

var pickerEl = document.getElementById("picker");
var searchInput = document.getElementById("wp-search");
var measuresEl = document.getElementById("wp-measures");
var vizToggle = document.getElementById("wp-viz");
var seriesShelfEl = document.getElementById("wp-series");
var seriesNoteEl = document.getElementById("wp-series-note");
var wpTitle = document.getElementById("wp-title");
var wpWidth = document.getElementById("wp-width");
var advDetails = document.getElementById("wp-advanced");
var advTool = document.getElementById("wp-adv-tool");
var advFieldSel = document.getElementById("wp-adv-field-sel");
var advField = document.getElementById("wp-adv-field");
var wpPreview = document.getElementById("wp-preview");
var addBtn = document.getElementById("wp-add");

var ADV_CUSTOM = "__custom__";   // sentinel field-select value → manual entry
var measuresCache = null;   // [{label,category,shape,component,source}]
var toolFieldsCache = null; // {tool: [{field,label,shape,component}]}
var catalogCache = null;    // {components:[...], tools:[...]}
var shelf = [];             // [{tool,field,label,shape}] — chosen measures, one tool
var activeViz = null;       // "number"|"line"|"area"|"column"|"bar"|"pie"|"table"
var noteTimer = null;
var previewSeq = 0;

function resetPicker(){
  shelf = [];
  activeViz = null;
  searchInput.value = "";
  wpTitle.value = "";
  wpWidth.value = "2";
  advDetails.open = false;
  advTool.value = "";
  advFieldSel.innerHTML = "";
  advField.value = "";
  advField.hidden = true;
  clearNote();
  renderShelf();
  renderVizButtons();
  wpPreview.innerHTML = "";
  addBtn.disabled = true;
  renderMeasureList("");
}

function openPicker(){
  resetPicker();
  pickerEl.hidden = false;
  pickerEl.setAttribute("aria-hidden", "false");
  if (!measuresCache) {
    fetch("/api/dashboard/measures").then(function(r){ return r.json(); }).then(function(d){
      measuresCache = (d && d.ok && d.measures) || [];
      toolFieldsCache = (d && d.ok && d.tool_fields) || {};
      renderMeasureList(searchInput.value);
    }).catch(function(){ measuresCache = []; toolFieldsCache = {}; });
  }
  if (!catalogCache) {
    fetch("/api/dashboard/catalog").then(function(r){ return r.json(); }).then(function(d){
      if (!d || !d.ok) return;
      catalogCache = d;
      var ph = document.createElement("option");
      ph.value = ""; ph.textContent = "— select tool —";
      advTool.appendChild(ph);
      (d.tools || []).forEach(function(t){
        var o = document.createElement("option");
        o.value = t; o.textContent = t;
        advTool.appendChild(o);
      });
    }).catch(function(){});
  }
  searchInput.focus();
}

function closePicker(){
  pickerEl.hidden = true;
  pickerEl.setAttribute("aria-hidden", "true");
}

// A measure is currently on the shelf if its tool+field matches a chip.
function isInShelf(m){
  var tool = (m.source && m.source.tool) || "";
  var field = (m.source && m.source.field) || "";
  for (var i = 0; i < shelf.length; i++) {
    if (shelf[i].tool === tool && shelf[i].field === field) return true;
  }
  return false;
}

// Is a measure row clickable right now?
//  - shelf non-empty: only measures of the same shape (they combine cleanly).
//  - shelf empty + a viz chosen: only shapes whose SHAPE_VIZ includes that viz.
//  - shelf empty + no viz: anything.
function rowEnabled(m){
  if (shelf.length) return m.shape === shelf[0].shape;
  if (!activeViz) return true;
  return (SHAPE_VIZ[m.shape] || []).indexOf(activeViz) !== -1;
}

function renderMeasureList(query){
  var q = (query || "").trim().toLowerCase();
  measuresEl.innerHTML = "";
  var list = measuresCache || [];
  if (!list.length) {
    var empty = document.createElement("div");
    empty.className = "wp-empty";
    empty.textContent = measuresCache ? "No measures found." : "Loading measures…";
    measuresEl.appendChild(empty);
    return;
  }
  var filtered = list.filter(function(m){
    if (!q) return true;
    var tool = (m.source && m.source.tool) || "";
    var field = (m.source && m.source.field) || "";
    var hay = [m.label, m.category, tool, field].join(" ").toLowerCase();
    return hay.indexOf(q) !== -1;
  });
  if (!filtered.length) {
    var none = document.createElement("div");
    none.className = "wp-empty";
    none.textContent = "No measures match “" + query + "”.";
    measuresEl.appendChild(none);
    return;
  }
  var lastCategory = null;
  filtered.forEach(function(m, idx){
    if (m.category !== lastCategory) {
      lastCategory = m.category;
      var head = document.createElement("div");
      head.className = "wp-group";
      head.textContent = m.category;
      measuresEl.appendChild(head);
    }
    var disabled = !rowEnabled(m);
    var row = document.createElement("div");
    row.className = "wp-row" + (disabled ? " disabled" : "") + (isInShelf(m) ? " sel" : "");
    row.dataset.idx = idx;

    var icon = document.createElement("div");
    icon.className = "wi";
    icon.textContent = SHAPE_ICON[m.shape] || "?";
    row.appendChild(icon);

    var t = document.createElement("div");
    t.className = "wt";
    var l = document.createElement("div");
    l.className = "l";
    l.textContent = m.label;
    var h = document.createElement("div");
    h.className = "h";
    var tool = (m.source && m.source.tool) || "";
    var field = (m.source && m.source.field) || "";
    h.textContent = tool + (field ? " · " + field : "");
    t.appendChild(l);
    t.appendChild(h);
    row.appendChild(t);

    row.addEventListener("click", function(){
      if (disabled) return;
      tryAddChip({ tool: (m.source && m.source.tool) || "", field: (m.source && m.source.field) || "",
                   label: m.label, shape: m.shape });
    });
    measuresEl.appendChild(row);
  });
}

// The compatible viz set for the current shelf: all types when empty, else the
// types SHAPE_VIZ allows for the first chip's shape. Number is single-measure, so
// it drops out once more than one measure is on the shelf.
function compatibleViz(){
  if (!shelf.length) return VIZ_TYPES.map(function(v){ return v.viz; });
  var set = (SHAPE_VIZ[shelf[0].shape] || []).slice();
  if (shelf.length > 1) set = set.filter(function(v){ return v !== "number"; });
  return set;
}

function renderVizButtons(){
  var compat = compatibleViz();
  vizToggle.innerHTML = "";
  VIZ_TYPES.forEach(function(vt){
    var enabled = compat.indexOf(vt.viz) !== -1;
    var b = document.createElement("button");
    b.type = "button";
    b.className = "pchip viz-btn" + (vt.viz === activeViz ? " active" : "");
    b.disabled = !enabled;
    b.title = vt.label;
    var g = document.createElement("span");
    g.className = "vg";
    g.textContent = vt.glyph;
    var l = document.createElement("span");
    l.className = "vl";
    l.textContent = vt.label;
    b.appendChild(g);
    b.appendChild(l);
    b.addEventListener("click", function(){ selectViz(vt.viz); });
    vizToggle.appendChild(b);
  });
}

function selectViz(viz){
  if (compatibleViz().indexOf(viz) === -1) return;   // disabled — no-op
  activeViz = viz;
  renderVizButtons();
  renderMeasureList(searchInput.value);
  refreshPreview();
}

function renderShelf(){
  seriesShelfEl.innerHTML = "";
  if (!shelf.length) {
    var empty = document.createElement("span");
    empty.className = "wp-empty";
    empty.textContent = "No measures yet — pick one from the list at left.";
    seriesShelfEl.appendChild(empty);
    return;
  }
  shelf.forEach(function(c, idx){
    var chip = document.createElement("span");
    chip.className = "chip";
    var l = document.createElement("span");
    l.textContent = c.label;
    chip.appendChild(l);
    var rm = document.createElement("button");
    rm.type = "button";
    rm.className = "chip-x";
    rm.setAttribute("aria-label", "Remove " + c.label);
    rm.textContent = "×";
    rm.addEventListener("click", function(ev){ ev.stopPropagation(); removeChip(idx); });
    chip.appendChild(rm);
    seriesShelfEl.appendChild(chip);
  });
}

function showNote(msg){
  seriesNoteEl.textContent = msg;
  seriesNoteEl.hidden = false;
  if (noteTimer) clearTimeout(noteTimer);
  noteTimer = setTimeout(clearNote, 3000);
}

function clearNote(){
  seriesNoteEl.hidden = true;
  seriesNoteEl.textContent = "";
}

// Add (or replace) a chip on the measures shelf.
//  - All chips must share one tool; a different tool is rejected with a note.
//  - Appends when the active viz is multi-measure and the new chip shares the
//    first chip's shape — series overlay as lines, scalars stack as bars/slices.
//    A breakdown (table-shaped) source fills a chart on its own, so it never
//    appends (stays a single chip). Otherwise the chip replaces the shelf.
//    Adding the first chip narrows the compatible viz set to its shape and
//    auto-picks a default (series→line, table→table, scalar→number).
function tryAddChip(chip){
  if (!chip || !chip.tool || !chip.field) return;
  if (shelf.length && shelf[0].tool !== chip.tool) {
    showNote("Measures on one widget must come from the same tool.");
    return;
  }
  clearNote();
  var canAppend = shelf.length > 0 && activeViz && MULTI_FIELD_VIZ.indexOf(activeViz) !== -1
                  && chip.shape === shelf[0].shape && chip.shape !== "table";
  if (canAppend) {
    var dup = false;
    for (var i = 0; i < shelf.length; i++) { if (shelf[i].field === chip.field) { dup = true; break; } }
    if (!dup) shelf.push(chip);
  } else {
    shelf = [chip];
  }
  if (!wpTitle.value.trim()) wpTitle.value = shelf[0].label;
  renderShelf();
  var compat = compatibleViz();
  if (!activeViz || compat.indexOf(activeViz) === -1) {
    activeViz = DEFAULT_VIZ_FOR_SHAPE[shelf[0].shape] || compat[0] || null;
  }
  renderVizButtons();
  renderMeasureList(searchInput.value);
  refreshPreview();
}

function removeChip(idx){
  shelf.splice(idx, 1);
  clearNote();
  renderShelf();
  var compat = compatibleViz();
  if (activeViz && compat.indexOf(activeViz) === -1) {
    activeViz = shelf.length ? (DEFAULT_VIZ_FOR_SHAPE[shelf[0].shape] || compat[0] || null) : activeViz;
  }
  renderVizButtons();
  renderMeasureList(searchInput.value);
  refreshPreview();
}

function currentPanel(){
  var width = Number(wpWidth.value) || 2;
  var title = wpTitle.value.trim();
  if (!shelf.length || !activeViz) return null;
  var fields = [];
  for (var i = 0; i < shelf.length; i++) fields.push(shelf[i].field);
  return { title: title, width: width, "viz": activeViz, data: { tool: shelf[0].tool, fields: fields } };
}

function refreshPreview(){
  var panel = currentPanel();
  addBtn.disabled = !panel;
  if (!panel) {
    wpPreview.innerHTML = "<div class='wp-empty'>Pick a measure to preview.</div>";
    return;
  }
  var seq = ++previewSeq;
  fetch("/api/dashboard/preview-panel", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ panel: panel, period: "all" })
  }).then(function(r){ return r.text(); }).then(function(html){
    if (seq !== previewSeq) return;
    wpPreview.innerHTML = html;
    hydrateVega(wpPreview);
  }).catch(function(){
    if (seq !== previewSeq) return;
    wpPreview.innerHTML = "<div class='dp-err'>preview failed</div>";
  });
}

// Fill the field <select> for the chosen tool (uncurated list from the measures
// payload), always with a trailing "Custom field…" for manual entry.
function populateAdvFields(tool){
  advFieldSel.innerHTML = "";
  var fields = (toolFieldsCache && toolFieldsCache[tool]) || [];
  fields.forEach(function(f){
    var o = document.createElement("option");
    o.value = f.field;
    o.textContent = f.label + " (" + f.field + ")";
    o.dataset.shape = f.shape;
    o.dataset.label = f.label;
    advFieldSel.appendChild(o);
  });
  var custom = document.createElement("option");
  custom.value = ADV_CUSTOM;
  custom.textContent = fields.length ? "Custom field…" : "Custom field… (no presets)";
  advFieldSel.appendChild(custom);
  advFieldSel.value = fields.length ? fields[0].field : ADV_CUSTOM;
  syncAdvField();
}

// Reveal the free-text box only for "Custom field…".
function syncAdvField(){
  advField.hidden = advFieldSel.value !== ADV_CUSTOM;
}

// Push the advanced tool+field onto the measures shelf, same rules as clicking
// a left-list measure. A preset field carries its real shape; a hand-typed
// custom field's shape is unknown, so it defaults by tool (trend fields are
// usually a series; anything else is treated as a table/breakdown).
function addAdvancedField(){
  var tool = advTool.value;
  if (!tool) return;
  var isCustom = advFieldSel.value === ADV_CUSTOM;
  var field = isCustom ? advField.value.trim() : advFieldSel.value;
  if (!field) return;
  var opt = !isCustom ? advFieldSel.options[advFieldSel.selectedIndex] : null;
  var shape = (opt && opt.dataset.shape) || (tool === "trend" ? "series" : "table");
  var label = (opt && opt.dataset.label) || field;
  tryAddChip({ tool: tool, field: field, label: label, shape: shape });
}

function onAdvToolChange(){
  if (advTool.value) populateAdvFields(advTool.value);
  else { advFieldSel.innerHTML = ""; advField.hidden = true; }
}

function onAdvFieldChange(){
  syncAdvField();
  if (advFieldSel.value !== ADV_CUSTOM) addAdvancedField();
}

searchInput.addEventListener("input", function(){ renderMeasureList(searchInput.value); });
wpTitle.addEventListener("change", refreshPreview);
wpWidth.addEventListener("change", refreshPreview);
advTool.addEventListener("change", onAdvToolChange);
advFieldSel.addEventListener("change", onAdvFieldChange);
advField.addEventListener("change", addAdvancedField);

document.getElementById("open-picker").addEventListener("click", openPicker);
document.getElementById("picker-close").addEventListener("click", closePicker);
document.getElementById("wp-cancel").addEventListener("click", closePicker);
pickerEl.addEventListener("click", function(ev){ if (ev.target === pickerEl) closePicker(); });
document.addEventListener("keydown", function(ev){ if (ev.key === "Escape" && !pickerEl.hidden) closePicker(); });

addBtn.addEventListener("click", function(){
  var panel = currentPanel();
  if (!panel) return;
  counter += 1;
  panel.id = "p" + counter;
  panels.push(panel);
  closePicker();
  renderList();
});

// ---- panel list (drag reorder / width / remove / live preview) --------

function renderList(){
  listEl.innerHTML = "";
  if (!panels.length) {
    var empty = document.createElement("div");
    empty.className = "empty";
    empty.textContent = "No panels yet — click + Add widget above.";
    listEl.appendChild(empty);
    return;
  }
  panels.forEach(function(p, i){
    var row = document.createElement("div");
    row.className = "panel-row";
    row.draggable = true;
    row.dataset.index = i;

    var handle = document.createElement("div");
    handle.className = "handle";
    handle.textContent = "☰";
    row.appendChild(handle);

    var meta = document.createElement("div");
    meta.className = "panel-meta";
    var t = document.createElement("div");
    t.className = "t";
    t.textContent = p.title || p.id;
    var s = document.createElement("div");
    s.className = "s";
    if (p.viz && p.data) {
      var fieldsTxt = (p.data.fields || []).join(" + ");
      s.textContent = p.viz + " · " + (p.data.tool || "?") + (fieldsTxt ? " (" + fieldsTxt + ")" : "");
    } else {
      var tool = (p.source && p.source.tool) || "?";
      var field = (p.source && p.source.field) || "";
      s.textContent = (p.component || "?") + " / " + tool + (field ? " (" + field + ")" : "");
    }
    meta.appendChild(t);
    meta.appendChild(s);
    row.appendChild(meta);

    var ctrls = document.createElement("div");
    ctrls.className = "panel-ctrls";
    var wLabel = document.createElement("label");
    wLabel.textContent = "Width";
    var wIn = document.createElement("input");
    wIn.type = "number";
    wIn.min = "1"; wIn.max = "6";
    wIn.value = p.width || 2;
    wIn.addEventListener("change", function(){
      panels[i].width = Number(wIn.value) || 2;
    });
    var rm = document.createElement("button");
    rm.type = "button";
    rm.textContent = "Remove";
    rm.addEventListener("click", function(){
      panels.splice(i, 1);
      renderList();
    });
    ctrls.appendChild(wLabel);
    ctrls.appendChild(wIn);
    ctrls.appendChild(rm);
    row.appendChild(ctrls);

    var prev = document.createElement("div");
    prev.className = "preview";
    row.appendChild(prev);

    row.addEventListener("dragstart", function(ev){
      dragIndex = i;
      ev.dataTransfer.effectAllowed = "move";
    });
    row.addEventListener("dragover", function(ev){
      ev.preventDefault();
      row.classList.add("drag-over");
    });
    row.addEventListener("dragleave", function(){
      row.classList.remove("drag-over");
    });
    row.addEventListener("drop", function(ev){
      ev.preventDefault();
      row.classList.remove("drag-over");
      if (dragIndex === null || dragIndex === i) return;
      var moved = panels.splice(dragIndex, 1)[0];
      panels.splice(i, 0, moved);
      dragIndex = null;
      renderList();
    });

    listEl.appendChild(row);
    preview(i);
  });
}

function preview(i){
  var row = listEl.querySelector('.panel-row[data-index="' + i + '"]');
  if (!row) return;
  var prev = row.querySelector(".preview");
  fetch("/api/dashboard/preview-panel", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ panel: panels[i], period: "all" })
  }).then(function(r){ return r.text(); }).then(function(html){
    prev.innerHTML = html;
    hydrateVega(prev);
  }).catch(function(){
    prev.innerHTML = "<div class='dp-err'>preview failed</div>";
  });
}

function save(){
  statusEl.textContent = "Saving…";
  statusEl.className = "status";
  fetch("/api/dashboard/" + DID, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ spec: { title: titleField.value, panels: panels }, visibility: visField.value })
  }).then(function(r){ return r.json(); }).then(function(d){
    if (d && d.ok) {
      spec.title = titleField.value;
      statusEl.textContent = "Saved";
      statusEl.className = "status ok";
    } else {
      statusEl.textContent = "Failed" + (d && d.error ? ": " + d.error : "");
      statusEl.className = "status err";
    }
  }).catch(function(){
    statusEl.textContent = "Failed";
    statusEl.className = "status err";
  });
}

document.getElementById("save").addEventListener("click", save);

renderList();
</script>
</body></html>
