      var rwown = r.owner ? '<a class="gh" href="#person" data-person="'+_esc(r.owner)+'">'+_esc(r.owner_name)+'</a>' : '<span class="dm">—</span>';
      return '<tr><td>'+rwref+' <span class="dm">'+_esc(r.repo)+'</span></td>'
        +'<td class="dt">'+(r.title?_esc(r.title):'<span class="dm">—</span>')+'</td>'
        +'<td>'+rwown+'</td><td class="dm">'+_esc(r.move)+'</td><td>'+_esc(r.date)+'</td></tr>';
    }
    var title = r.title ? _esc(r.title) : '<span class="dm">—</span>';
    return '<tr><td><a href="'+_esc(r.url)+'" target="_blank" rel="noopener">'+_esc(r.short)+'</a></td>'
      +'<td class="dt">'+title+'</td>'
      +'<td>'+_esc(r.repo)+'</td><td>'+_esc(r.author)+'</td><td>'+_esc(r.date)+'</td>'
      +'<td class="dm">'+_esc(r.meta)+'</td></tr>';
  }
  function _drillTitle(st){
    var noun = st.isPeople ? (st.total===1?'person':'people')
      : st.isCI ? ('gate run'+(st.total===1?'':'s'))
      : st.isFlow ? ('work item'+(st.total===1?'':'s'))
      : st.isFlowItems ? ('flow item'+(st.total===1?'':'s'))
      : st.isRewinds ? ('board rewind'+(st.total===1?'':'s'))
      : (st.entity+(st.total===1?'':'s'));
    if(st.total==null) return 'Loading…';
    return (st.loaded < st.total ? (_num(st.loaded)+' of '+_num(st.total)) : _num(st.total)) + ' ' + noun;
  }
  function _drillLoad(){
    var st=_drill; if(!st || st.loading || st.done) return;
    st.loading=true;
    _api('/api/drill?'+st.qs+'&limit='+_DRILL_PAGE+'&offset='+st.loaded).then(function(r){return r.json();})
      .then(function(s){
        st.loading=false;
        if(!_drill || _drill!==st) return;                 // a newer drill opened
        if(!s || !s.ok){ if(!st.loaded) st.tt.textContent=(s&&s.error)||'error'; return; }
        st.total=s.total;
        var cols = st.isPeople?8:((st.isFlow||st.isFlowItems||st.isRewinds)?5:6);
        if(!st.loaded && (!s.rows || !s.rows.length)){
          st.tb.innerHTML='<tr><td colspan="'+cols+'" class="dm">Nothing here.</td></tr>'; st.done=true;
          st.tt.textContent=_drillTitle(st); return;
        }
        st.tb.insertAdjacentHTML('beforeend', s.rows.map(function(r){return _drillRow(st,r);}).join(''));
        st.loaded += s.rows.length;
        if(st.loaded>=st.total || !s.rows.length) st.done=true;
        st.tt.textContent=_drillTitle(st);
        // if the first page didn't fill the scroll area, keep pulling
        if(!st.done && st.sc.scrollHeight <= st.sc.clientHeight + 40) _drillLoad();
      }).catch(function(){ st.loading=false; if(!st.loaded) st.tt.textContent='failed to load'; });
  }
  function openDrill(entity, flag, extra, scopeOverride){
    // 'none' forces org-wide (used by the Person page, which isn't slice-scoped);
    // a real override wins; otherwise inherit the global slice.
    var scope = (scopeOverride==='none') ? ''
      : ((scopeOverride!=null && scopeOverride!=='') ? scopeOverride : _scope);
    // a cell may pin its own window (e.g. one week) via extra.from/to — that replaces
    // the active period; otherwise inherit _curQS.
    var period = (extra && extra.from)
      ? ('from='+encodeURIComponent(extra.from) + (extra.to?'&to='+encodeURIComponent(extra.to):''))
      : _curQS;
    var qs = period + (scope?'&scope='+encodeURIComponent(scope):'')
      + '&entity='+encodeURIComponent(entity) + (flag?'&flag='+encodeURIComponent(flag):'');
    if(extra){ for(var k in extra){ if(k!=='from' && k!=='to' && extra[k]) qs += '&'+k+'='+encodeURIComponent(extra[k]); } }
    var ov=document.getElementById('drill'), tt=document.getElementById('drill-title'),
        tb=document.getElementById('drill-body'), th=document.getElementById('drill-head-row'),
        sc=document.querySelector('#drill .drill-scroll');
    var isPeople = (entity === 'people'), isCI = (entity === 'ci'), isFlow = (entity === 'flow'),
        isFlowItems = (entity === 'flowitems'), isRewinds = (entity === 'rewinds');
    th.innerHTML = isPeople
      ? '<th>Person</th><th>Company</th><th>Commits</th><th>PRs</th><th>Specs</th><th>Bugs</th><th>Epics</th><th>Features</th>'
      : isCI
      ? '<th>Run</th><th>Workflow</th><th>Repo</th><th>Conclusion</th><th>Duration</th><th>Date</th>'
      : isFlow
      ? '<th>Item</th><th>Title</th><th>Repo</th><th>Type</th><th>Status</th>'
      : isFlowItems
      ? '<th>Item</th><th>Title</th><th>Type</th><th>Friction</th><th>Events</th>'
      : isRewinds
      ? '<th>Item</th><th>Title</th><th>Owner</th><th>Move</th><th>Detected</th>'
      : '<th>Ref</th><th>Title</th><th>Repo</th><th>Author</th><th>Date</th><th>Details</th>';
    tb.innerHTML=''; tt.textContent='Loading…'; sc.scrollTop=0; ov.classList.add('open');
    _drill = {qs:qs, entity:entity, isPeople:isPeople, isCI:isCI, isFlow:isFlow, isFlowItems:isFlowItems, isRewinds:isRewinds, loaded:0, total:null,
              loading:false, done:false, tt:tt, tb:tb, sc:sc};
    // remember the open drill in the URL so a shared link reopens it
    window.__curDrill = {entity:entity, flag:flag||'', extra:extra||{}, scope:scopeOverride||''};
    if(window.__syncURL) window.__syncURL();
    if(!sc._drillBound){ sc._drillBound=true; sc.addEventListener('scroll', function(){
      if(_drill && !_drill.done && !_drill.loading &&
         sc.scrollTop + sc.clientHeight >= sc.scrollHeight - 160) _drillLoad();
    }, {passive:true}); }
    _drillLoad();
  }
  window.openDrill = openDrill;
  function _closeDrill(){ var d=document.getElementById('drill'); if(d) d.classList.remove('open');
    window.__curDrill = null; if(window.__syncURL) window.__syncURL(); }
  // --- CSV export (one place for every drill) ------------------------------
  // Column spec per entity type — plain values, no HTML. Mirrors the table header.
  function _drillCsvSpec(st){
    if(st.isPeople) return {h:['Name','Login','Membership','Company','Commits','PRs','Specs','Bugs','Epics','Features'],
      row:function(r){return [r.name,r.login,r.is_member?'member':'external',r.company,r.commits,r.prs,r.specs,r.bugs,r.epics,r.features];}};
    if(st.isCI) return {h:['Run','Workflow','Repo','Conclusion','Duration','Date','URL'],
      row:function(r){return [r.ref,r.title,r.repo,r.conclusion,r.duration,r.date,r.url];}};
    if(st.isFlow) return {h:['Item','Title','Repo','Type','Status','URL'],
      row:function(r){return [r.ref,r.title,r.repo,r.item_type,r.status,r.url];}};
    if(st.isFlowItems) return {h:['Item','Repo','Title','Type','Friction','Events'],
      row:function(r){return [r.ref,r.repo,r.title,r.item_type,r.friction,r.detail];}};
    if(st.isRewinds) return {h:['Item','Repo','Title','Owner','Owner login','Move','Detected','URL'],
      row:function(r){return [r.ref,r.repo,r.title,r.owner_name,r.owner,r.move,r.date,r.url];}};
    return {h:['Ref','Title','Repo','Author','Date','Details','URL'],
      row:function(r){return [r.short,r.title,r.repo,r.author,r.date,r.meta,r.url];}};
  }
  function _csvCell(v){ v=(v==null?'':String(v)); return /[",\n\r]/.test(v)?'"'+v.replace(/"/g,'""')+'"':v; }
  function _drillExportCSV(){
    var st=_drill; if(!st) return;
    var btn=document.getElementById('drill-csv'), spec=_drillCsvSpec(st);
    var all=[], off=0, PAGE=1000, MAX=100000;
    function reset(t){ if(btn){ btn.disabled=false; btn.textContent=t||'Export CSV'; } }
    function fail(){ reset('Export failed'); setTimeout(function(){ reset(); }, 2200); }
    if(btn){ btn.disabled=true; btn.textContent='Exporting…'; }
    (function step(){
      // reuse the SAME query the drill was opened with — so filters/scope/period match
      _api('/api/drill?'+st.qs+'&limit='+PAGE+'&offset='+off).then(function(r){return r.json();}).then(function(s){
        if(!s||!s.ok){ fail(); return; }
        var got=s.rows||[]; all=all.concat(got); off+=got.length;
        // keep paging while a full page came back and we're under the total / safety cap
        if(got.length>=PAGE && off<MAX && (s.total==null || off<s.total)){ step(); return; }
        var lines=[spec.h.map(_csvCell).join(',')];
        for(var i=0;i<all.length;i++) lines.push(spec.row(all[i]).map(_csvCell).join(','));
        var csv='﻿'+lines.join('\r\n');                 // BOM so Excel reads UTF-8 (Cyrillic names)
        var blob=new Blob([csv],{type:'text/csv;charset=utf-8'}), url=URL.createObjectURL(blob);
        var a=document.createElement('a'); a.href=url;
        a.download='drill-'+(st.entity||'rows')+'-'+all.length+'-rows.csv';
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        setTimeout(function(){ URL.revokeObjectURL(url); }, 1000);
        reset();
      }).catch(fail);
    })();
  }
  window._drillExportCSV = _drillExportCSV;
  // fully delegated so it works even though the modal is parsed after this script
  document.addEventListener('click', function(e){
    var k=e.target.closest('[data-drill]');
    if(k){ openDrill(k.getAttribute('data-drill'), k.getAttribute('data-flag')||'',
      {author:k.getAttribute('data-author')||'', company:k.getAttribute('data-company')||'',
       classification:k.getAttribute('data-classification')||'',
       category:k.getAttribute('data-category')||'',
       commit_type:k.getAttribute('data-commit-type')||'', pr_state:k.getAttribute('data-pr-state')||'',
       ai_tool:k.getAttribute('data-ai-tool')||'', spec:k.getAttribute('data-spec')||'',
       members:k.getAttribute('data-members')||'', reviewed:k.getAttribute('data-reviewed')||'',
       stage:k.getAttribute('data-stage')||'',
       from:k.getAttribute('data-from')||'', to:k.getAttribute('data-to')||''},
      k.getAttribute('data-scope')); return; }
    if(e.target.id==='drill-csv'){ e.preventDefault(); _drillExportCSV(); return; }
    if(e.target.id==='drill-close' || e.target.id==='drill') _closeDrill();
  });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') _closeDrill(); });
})();
</script>
