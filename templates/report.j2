<div id="drill" class="drill-ov" aria-hidden="true">
  <div class="drill-box">
    <div class="drill-head"><b id="drill-title"></b>
      <span class="drill-actions"><button id="drill-csv" type="button" title="Download all rows as CSV">Export CSV</button><button id="drill-close" type="button" aria-label="Close">×</button></span></div>
    <div class="drill-scroll"><table class="drill-tbl">
      <thead><tr id="drill-head-row"><th>Ref</th><th>Title</th><th>Repo</th><th>Author</th><th>Date</th><th>Details</th></tr></thead>
      <tbody id="drill-body"></tbody></table></div>
  </div>
</div>
<script>
/* Usage collector — meta-analytics for this report itself. No-ops without
   IntersectionObserver/sendBeacon (so it ships inert in the emailed copy).
   Identity is resolved SERVER-SIDE from the proxy headers; this sends only event
   kinds/targets/timing, never who you are. Panels are keyed by their existing
   data-period-panel slug; the observer watches the persistent wrapper, which
   survives the innerHTML swap /api/period does on reslice. */
(function(){
  if (!('IntersectionObserver' in window) || !navigator.sendBeacon) return;
  var SID = (window.crypto && crypto.randomUUID) ? crypto.randomUUID()
            : (String(Date.now()) + Math.random().toString(16).slice(2));
  var queue = [];
  function currentTab(){
    var b = document.querySelector('.tabs .tab.active');
    return (b && b.getAttribute('data-mode')) || 'overview';
  }
  function currentPeriod(){
    var c = document.querySelector('.pchip.active');
    return c ? (c.getAttribute('data-pchip') || '') : '';
  }
  function flush(){
    if (!queue.length) return;
    var batch = queue; queue = [];
    try {
      navigator.sendBeacon('/api/usage',
        new Blob([JSON.stringify({session_id: SID, events: batch})],
                 {type: 'application/json'}));
    } catch (e) { /* best-effort; a dropped beacon is acceptable */ }
  }
  function enqueue(ev){ queue.push(ev); if (queue.length >= 20) flush(); }
  // Let other widgets (e.g. the metrics assistant) ride the same session + batch.
  window.__reportUsage = enqueue;

  // --- tabs: record the RESOLVED mode (the active tab button), not the raw hash
  var lastTab = null;
  function recordTab(){
    var m = currentTab();
    if (m === lastTab) return;
    lastTab = m;
    enqueue({kind:'tab', target:m, period: currentPeriod()});
  }
  document.addEventListener('click', function(e){
    if (e.target.closest && e.target.closest('.tabs .tab')) setTimeout(recordTab, 0);
  });
  window.addEventListener('hashchange', function(){ setTimeout(recordTab, 0); });

  // --- panels: >=50% visible for >=1s, once per session per (slug, all-vs-tab).
  // Keying on all-vs-tab lets a widget seen in a real tab still count even if it
  // was first glimpsed on the All tab (which by_widget excludes).
  var DWELL_MS = 1000, seen = {}, timers = {}, enterAt = {};
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      var slug = en.target.getAttribute('data-period-panel');
      if (!slug) return;
      if (en.isIntersecting && en.intersectionRatio >= 0.5){
        if (timers[slug]) return;
        enterAt[slug] = Date.now();
        timers[slug] = setTimeout(function(){
          timers[slug] = 0;
          var tab = currentTab();
          var key = slug + (tab === 'all' ? '#all' : '#tab');
          if (seen[key]) return;
          seen[key] = 1;
          enqueue({kind:'panel', target:slug, tab:tab,
                   dwell_ms: Date.now() - (enterAt[slug] || Date.now()),
                   period: currentPeriod()});
        }, DWELL_MS);
      } else if (timers[slug]) {
        clearTimeout(timers[slug]); timers[slug] = 0;
      }
    });
  }, {threshold: [0, 0.5]});
  document.querySelectorAll('[data-period-panel]').forEach(function(el){ io.observe(el); });

  // --- drills: record every drill-down open. User clicks go through the report's
  // OWN local openDrill (not window.openDrill), so a delegated click listener on
  // [data-drill] is the reliable hook; the target is the drill entity + its flag
  // (e.g. "commit", "prs/merged"). We ALSO wrap window.openDrill to catch the
  // programmatic reopen from a shared ?drill=… URL (which bypasses any click).
  function drillTarget(el){
    var flag = el.getAttribute('data-flag');
    return el.getAttribute('data-drill') + (flag ? '/' + flag : '');
  }
  document.addEventListener('click', function(e){
    var k = e.target.closest && e.target.closest('[data-drill]');
    if (k) enqueue({kind:'drill', target: drillTarget(k),
                    tab: currentTab(), period: currentPeriod()});
  });
  if (typeof window.openDrill === 'function' && !window.openDrill.__usageWrapped){
    var _openDrill = window.openDrill;
    window.openDrill = function(entity, flag){
      try {
        enqueue({kind:'drill', target: entity + (flag ? '/' + flag : ''),
                 tab: currentTab(), period: currentPeriod()});
      } catch(e){ /* never block the drill */ }
      return _openDrill.apply(this, arguments);
    };
    window.openDrill.__usageWrapped = true;
  }

  // --- flush triggers
  document.addEventListener('visibilitychange', function(){
    if (document.visibilityState === 'hidden') flush();
  });
  window.addEventListener('pagehide', flush);
  setInterval(flush, 15000);

  setTimeout(recordTab, 0);   // initial tab on load
})();
</script>

<script>
/* Metrics assistant — a floating chat over POST /api/chat (SSE). Built entirely in
   JS and appended at <body> level (like #tip/#totop) so it NEVER appears in the
   emailed copy, where mail clients strip <script>. Also gated to a live http(s)
   server, so a report opened as a local file shows no dead launcher. Vanilla, no
   deps; every visible number comes from the server tools, not the model's memory. */
(function(){
  if (!/^https?:$/.test(location.protocol)) return;      // live portal only
  if (!window.fetch || typeof ReadableStream === 'undefined') return;

  var history = [];          // [{role, text}] clean turns; the server builds context
  var busy = false;
  // One conversation id per panel session, so the server can group the transcript.
  var convId = (window.crypto && crypto.randomUUID) ? crypto.randomUUID()
             : (String(Date.now()) + Math.random().toString(16).slice(2));

  var fab = document.createElement('button');
  fab.id = 'mx-fab'; fab.title = 'Ask about these metrics';
  fab.setAttribute('aria-label', 'Ask about these metrics');
  fab.innerHTML = '<svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-8.5 8.5'
    + ' 8.5 8.5 0 0 1-3.6-.8L3 21l1.8-5.9A8.5 8.5 0 1 1 21 11.5z"/></svg>';
  document.body.appendChild(fab);

  var panel = document.createElement('div'); panel.id = 'mx-panel';
  panel.innerHTML =
    '<div class="mx-head"><span class="mx-t">Metrics assistant</span>'
    + '<span class="mx-sub">grounded in this report</span>'
    + '<button class="mx-exp" aria-label="Expand" title="Expand">⤢</button>'
    + '<button class="mx-x" aria-label="Close">×</button></div>'
    + '<div class="mx-body"></div>'
    + '<div class="mx-foot"><textarea rows="1" placeholder="Ask why a number moved…">'
    + '</textarea><button class="mx-send">Send</button></div>';
  document.body.appendChild(panel);

  var body = panel.querySelector('.mx-body');
  var ta = panel.querySelector('textarea');
  var expBtn = panel.querySelector('.mx-exp');
  var sendBtn = panel.querySelector('.mx-send');
  var empty = document.createElement('div'); empty.className = 'mx-empty';
  empty.textContent = 'Ask about any metric — I read the live report data to answer.';
  body.appendChild(empty);

  // Report the current view (hash) + active period preset — parity with the usage
  // collector's privacy stance: event kind + context only, never the question text.
  function curView(){ return (location.hash || '').replace(/^#/, '') || null; }
  function curPeriod(){
    var c = document.querySelector('.pchip.active[data-pchip]');
    if (c) return c.textContent.trim();
    var cb = document.getElementById('pcustbtn');   // custom range: label is 'from → to'
    if (cb && cb.textContent && cb.textContent.indexOf('Custom') === -1) return cb.textContent.trim();
    return null;
  }
  function curScope(){
    var s = document.getElementById('global-scope');
    return s ? (s.value || '') : '';   // '' = whole org; else '<level>:<target>'
  }
  function usage(ev){ if (window.__reportUsage) { try { window.__reportUsage(ev); } catch (e) {} } }

  function openPanel(){ panel.classList.add('open'); fab.classList.add('hide');
    usage({kind: 'chat_open', target: curView(), period: curPeriod()});
    setTimeout(function(){ ta.focus(); }, 50); }
  function closePanel(){ panel.classList.remove('open'); fab.classList.remove('hide'); }
  function toggleMax(){
    var on = panel.classList.toggle('max');
    expBtn.textContent = on ? '⤡' : '⤢';
    expBtn.title = on ? 'Restore' : 'Expand';
    body.scrollTop = body.scrollHeight;
  }
  fab.addEventListener('click', openPanel);
  panel.querySelector('.mx-x').addEventListener('click', closePanel);
  expBtn.addEventListener('click', toggleMax);

  function bubble(cls, text){
    if (empty.parentNode) empty.remove();
    var d = document.createElement('div'); d.className = 'mx-msg ' + cls;
    d.textContent = text || '';
    body.appendChild(d); body.scrollTop = body.scrollHeight; return d;
  }

  // Minimal, XSS-safe Markdown for bot bubbles: escape ALL HTML first, then apply a
  // small subset the model actually emits (bold/italic/code/links/lists/headings).
  // Because escaping runs before any tag is inserted, model output containing report
  // data (commit messages, logins) can never inject markup. Links restricted to
  // http(s) or root-relative URLs.
  function mxEsc(s){
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
  function mxInline(s){                              // s is already HTML-escaped
    s = s.replace(/`([^`]+)`/g, function(_m, c){ return '<code>' + c + '</code>'; });
    s = s.replace(/\[([^\]]+)\]\((https?:\/\/[^)\s"'<>]+|\/[^)\s"'<>]*)\)/g,
        function(_m, t, u){
          return '<a href="' + u + '" target="_blank" rel="noopener noreferrer">' + t + '</a>';
        });
    s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    s = s.replace(/(^|[^*])\*([^*\n]+)\*/g, '$1<em>$2</em>');
    s = s.replace(/_([^_\n]+)_/g, '<em>$1</em>');
    return s;
  }
  // A markdown pipe-table: a row containing '|' immediately followed by a separator
  // row (only |, -, :, spaces, with at least one '|' and one '-').
  function mxIsSep(s){ return /^[\s|:-]+$/.test(s) && s.indexOf('|') >= 0 && s.indexOf('-') >= 0; }
  function mxCells(s){
    return s.trim().replace(/^\|/, '').replace(/\|$/, '').split('|')
            .map(function(c){ return mxInline(c.trim()); });
  }
  function mxMarkdown(el, raw){
    var lines = mxEsc(raw).split('\n'), html = '', list = null, para = [];
    function flushPara(){ if (para.length){ html += '<p>' + para.join('<br>') + '</p>'; para = []; } }
    function flushList(){ if (list){ html += '</' + list + '>'; list = null; } }
    for (var i = 0; i < lines.length; i++){
      var ln = lines[i];
      if (ln.indexOf('|') >= 0 && i + 1 < lines.length && mxIsSep(lines[i + 1])){
        flushPara(); flushList();
        var head = mxCells(ln), rows = [];
        i += 2;                                     // consume header + separator
        while (i < lines.length && lines[i].indexOf('|') >= 0 && lines[i].trim() !== ''){
          rows.push(mxCells(lines[i])); i++;
        }
        i--;                                        // the for-loop will step past
        html += '<table><thead><tr>'
          + head.map(function(h){ return '<th>' + h + '</th>'; }).join('')
          + '</tr></thead><tbody>'
          + rows.map(function(r){ return '<tr>'
              + r.map(function(c){ return '<td>' + c + '</td>'; }).join('') + '</tr>'; }).join('')
          + '</tbody></table>';
        continue;
      }
      var ul = ln.match(/^\s*[-*]\s+(.*)$/), ol = ln.match(/^\s*\d+\.\s+(.*)$/),
          hd = ln.match(/^\s*#{1,6}\s+(.*)$/);
      if (ul){ flushPara(); if (list !== 'ul'){ flushList(); html += '<ul>'; list = 'ul'; }
        html += '<li>' + mxInline(ul[1]) + '</li>'; }
      else if (ol){ flushPara(); if (list !== 'ol'){ flushList(); html += '<ol>'; list = 'ol'; }
        html += '<li>' + mxInline(ol[1]) + '</li>'; }
      else if (hd){ flushPara(); flushList(); html += '<p><strong>' + mxInline(hd[1]) + '</strong></p>'; }
      else if (ln.trim() === ''){ flushPara(); flushList(); }
      else { flushList(); para.push(mxInline(ln)); }
    }
    flushPara(); flushList();
    el.innerHTML = html;
  }
  function toolChip(names){
    if (empty.parentNode) empty.remove();
    var d = document.createElement('div'); d.className = 'mx-tool';
    var codes = (names || []).map(function(n){
      return '<code>' + String(n).replace(/[<&]/g, '') + '</code>'; }).join('');
    d.innerHTML = 'fetched' + codes;
    body.appendChild(d); body.scrollTop = body.scrollHeight;
  }

  // What the user is currently looking at — so the model scopes its answer to the
  // same slice/period/tab. Appended to the sent message (kept out of the visible
  function send(){
    var text = ta.value.trim();
    if (!text || busy) return;
    busy = true; sendBtn.disabled = true; ta.value = ''; ta.style.height = 'auto';
    bubble('user', text);
    // Send the CLEAN question plus structured context; the SERVER builds the
    // model prompt (scope/period/view + verified identity) and records everything —
    // tokens/cost, and the clean transcript. The client stores clean text in history.
    var view = curView(), period = curPeriod(), scope = curScope();
    var prior = history.slice();          // history the model gets, minus this message
    history.push({role: 'user', text: text});
    var bot = null, acc = '';

    function finish(){
      if (acc) history.push({role: 'assistant', text: acc});
      busy = false; sendBtn.disabled = false; ta.focus();
    }

    fetch('/api/chat', {method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({message: text, history: prior, view: view, period: period,
                              scope: scope, session_id: convId})})
      .then(function(r){
        if (!r.ok || !r.body) throw new Error('HTTP ' + r.status);
        var reader = r.body.getReader(), dec = new TextDecoder(), buf = '';
        function pump(){
          return reader.read().then(function(res){
            if (res.done){ finish(); return; }
            buf += dec.decode(res.value, {stream: true});
            var parts = buf.split('\n\n'); buf = parts.pop();
            parts.forEach(function(chunk){
              var line = chunk.replace(/^data:\s?/, '').trim();
              if (!line) return;
              var ev; try { ev = JSON.parse(line); } catch (e){ return; }
              if (ev.type === 'tool'){ toolChip(ev.tools); }
              else if (ev.type === 'text'){
                if (!bot) bot = bubble('bot', '');
                acc += ev.text; mxMarkdown(bot, acc); body.scrollTop = body.scrollHeight;
              } else if (ev.type === 'error'){
                bubble('err', ev.error || 'Something went wrong.');
              }
            });
            return pump();
          });
        }
        return pump();
      })
      .catch(function(e){
        bubble('err', 'Could not reach the assistant (' + e.message + ').');
        finish();
      });
  }
  sendBtn.addEventListener('click', send);
  ta.addEventListener('keydown', function(e){
    if (e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); send(); }
  });
  ta.addEventListener('input', function(){
    ta.style.height = 'auto'; ta.style.height = Math.min(ta.scrollHeight, 120) + 'px';
  });
})();
</script>
</body></html>
