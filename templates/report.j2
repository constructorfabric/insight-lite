<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Constructor Insight — Contribution &amp; Usage Report</title>
<style>
  {% if jakarta_woff2 %}@font-face{font-family:'Jakarta';font-style:normal;font-weight:400 800;
    font-display:swap;src:url(data:font/woff2;base64,{{ jakarta_woff2 }}) format('woff2');}{% endif %}
  {% if inter_woff2 %}@font-face{font-family:'Inter';font-style:normal;font-weight:100 900;
    font-display:swap;src:url(data:font/woff2;base64,{{ inter_woff2 }}) format('woff2');}{% endif %}
  :root{
    --bg:#f5f6f9; --panel:#ffffff; --panel2:#eef1f5; --line:#eceef2; --line2:#e2e6ec;
    --ink:#101828; --ink2:#475467; --mut:#8a93a3;
    --acc:#5b5bf0; --acc-ink:#4a45d6; --good:#0f9d58; --good-bg:#e7f6ee;
    --warn:#b7791f; --bad:#e5484d; --bad-bg:#fdeaea; --plat:#5b5bf0; --app:#8b5cf6;
    --c-commit:#5b5bf0; --c-loc:#8b5cf6; --c-pr:#2f80ed; --c-spec:#f59e0b;
    --c-bug:#ef4444; --c-epic:#8b5cf6; --c-story:#10b981; --c-feature:#10b981; --c-people:#06b6d4;
    --r:16px; --r-sm:12px; --sh:0 1px 2px rgba(16,24,40,.04),0 1px 3px rgba(16,24,40,.06);
    --sh-lift:0 10px 30px rgba(16,24,40,.10);
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);
    font:14.5px/1.55 'Jakarta','Inter',-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
  .num{font-variant-numeric:tabular-nums;letter-spacing:-.02em}
  {{ shell_css|safe }}
  .wrap{padding:24px 34px 64px}
  h1{font-size:24px;font-weight:800;letter-spacing:-.03em;margin:0 0 4px}
  h2{font-size:18px;font-weight:800;letter-spacing:-.02em;margin:38px 0 14px}
  h2 .eyebrow{display:block;font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;
    color:var(--acc);margin-bottom:5px}
  h3{font-weight:700;letter-spacing:-.01em}
  .sub{color:var(--ink2);font-size:13px;margin:0 0 14px}
  .topbar{position:sticky;top:0;z-index:50;margin:0 0 18px;padding:11px 0 9px;
    background:rgba(245,246,249,.82);border-bottom:1px solid var(--line);
    backdrop-filter:saturate(160%) blur(10px)}
  @media(max-width:900px){ .wrap{padding:16px} }
  .mode-section[hidden]{display:none}
  h2{scroll-margin-top:92px}
  svg.i{stroke-linecap:round;stroke-linejoin:round;fill:none}
  .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(172px,1fr));gap:14px}
  .kpi[data-drill]{cursor:pointer;transition:box-shadow .14s,transform .14s}
  .kpi[data-drill]:hover{box-shadow:var(--sh-lift);transform:translateY(-2px)}
  .ktop{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px}
  .ico{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;flex:none}
  .ico svg{width:18px;height:18px;stroke:#fff;stroke-width:2}
  td[data-drill]{cursor:pointer;text-decoration:underline dotted var(--line);text-underline-offset:3px}
  td[data-drill]:hover{color:var(--acc);text-decoration-color:var(--acc)}
  .legend span[data-drill]{cursor:pointer;text-decoration:underline dotted var(--line);text-underline-offset:3px;font-weight:600}
  .legend span[data-drill]:hover{color:var(--acc);text-decoration-color:var(--acc)}
  .row[data-drill]{cursor:pointer;border-radius:6px} .row[data-drill]:hover{background:var(--panel2,#eaeef2)}
  .m[data-drill]{cursor:pointer} .m[data-drill]:hover .mv{color:var(--acc)}
  .leg .it[data-drill]{cursor:pointer} .leg .it[data-drill]:hover{color:var(--acc)}
  span.dr[data-drill]{cursor:pointer;text-decoration:underline dotted var(--line);text-underline-offset:3px}
  span.dr[data-drill]:hover{color:var(--acc);text-decoration-color:var(--acc)}
  .drill-ov{display:none;position:fixed;top:0;left:0;width:100vw;height:100vh;
    background:rgba(0,0,0,.45);z-index:200;align-items:flex-start;justify-content:center;padding:5vh 16px}
  .drill-ov.open{display:flex}
  .drill-box{background:var(--panel);border:1px solid var(--line);border-radius:12px;
    width:max-content;max-width:80vw;min-width:min(600px,94vw);
    max-height:88vh;display:flex;flex-direction:column;box-shadow:0 14px 50px rgba(0,0,0,.3)}
  .drill-head{display:flex;align-items:center;justify-content:space-between;gap:10px;
    padding:12px 16px;border-bottom:1px solid var(--line)}
  .drill-head b{font-size:14px} .drill-head button{border:none;background:none;font-size:22px;
    line-height:1;cursor:pointer;color:var(--mut)}
  .drill-actions{display:flex;align-items:center;gap:10px}
  #drill-csv{font-size:12px;font-weight:700;color:var(--acc);border:1px solid var(--line);
    border-radius:7px;padding:5px 10px;background:var(--panel)}
  #drill-csv:hover{border-color:var(--acc)} #drill-csv:disabled{opacity:.55;cursor:default}
  .drill-scroll{overflow:auto}
  .drill-tbl{width:auto;border-collapse:collapse;font-size:13px}
  .drill-tbl th{position:sticky;top:0;background:var(--panel);text-align:left;padding:8px 12px;
    border-bottom:1px solid var(--line);font-size:11px;color:var(--mut);white-space:nowrap}
  .drill-tbl td{padding:6px 12px;border-bottom:1px solid var(--line);vertical-align:top;
    text-align:left;white-space:nowrap}
  .drill-tbl tr:hover td{background:var(--panel2,#eaeef2)}
  .drill-tbl a{font-family:ui-monospace,Menlo,monospace;color:var(--acc);text-decoration:none}
  .drill-tbl .dm{color:var(--mut)}
  .drill-tbl .dt{max-width:46vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .dslice{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin:0 0 14px}
  .dslice label{font-size:12px;font-weight:700;color:var(--mut)}
  .dslice select{padding:6px 9px;border:1px solid var(--line);border-radius:8px;
    background:var(--panel);color:var(--ink);font:inherit;font-size:13px;max-width:280px}
  .dslice-note{font-size:12px;color:var(--mut)}
  .kpi{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);
    padding:16px 17px;box-shadow:var(--sh)}
  .kpi .n{font-size:29px;font-weight:800;line-height:1;letter-spacing:-.03em;
    font-variant-numeric:tabular-nums} .kpi .l{font-size:13px;font-weight:600;margin-top:7px}
  .kpi .l2{color:var(--mut);font-size:11.5px;margin-top:2px;line-height:1.3}
  /* period-over-period delta pill */
  .dlt{font-size:11.5px;font-weight:700;padding:3px 8px;border-radius:999px;
    white-space:nowrap;display:inline-flex;align-items:center;gap:3px;letter-spacing:.01em}
  .dlt.up{color:var(--good);background:var(--good-bg)}
  .dlt.down{color:var(--bad);background:var(--bad-bg)}
  .dlt.flat{color:var(--mut);background:var(--panel2)}
  /* in-window activity sparkline under the headline KPIs */
  .spark{display:block;width:100%;height:22px;margin-top:9px;opacity:.72}
  .defs{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:8px;margin:10px 0 0}
  .def{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:10px 12px}
  .def b{display:block;font-size:13px;margin-bottom:2px}.def span{display:block;color:var(--mut);font-size:12px;line-height:1.4}
  details.readme{margin:12px 0 0;border:1px solid var(--line);border-radius:8px;background:var(--panel)}
  details.readme summary{cursor:pointer;color:var(--mut);font-weight:600;font-size:13px;padding:9px 12px;list-style:none}
  details.readme summary::-webkit-details-marker{display:none}
  details.readme summary::before{content:"\25B8 ";color:var(--acc)}
  details.readme[open] summary::before{content:"\25BE "}
  details.readme > div{padding:0 12px 12px}
  .strip-h{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;
    color:var(--mut);margin:22px 0 8px}
  .grid2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px}
  @media(max-width:760px){.grid2{grid-template-columns:1fr}}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:18px;box-shadow:var(--sh)}
  .card.good{border-color:#a0d8b0} .card.warn{border-color:#e8d8a0}
  .card h3{margin:0 0 4px;font-size:17px} .card .hint{color:var(--mut);font-size:13px;margin:0 0 12px}
  .quality{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin:0 0 18px}
  .qitem{background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--line2);
    border-radius:12px;padding:14px 16px;box-shadow:var(--sh);transition:box-shadow .15s,transform .15s}
  .qitem.ok{border-left-color:var(--good)}.qitem.warn{border-left-color:var(--c-spec)}.qitem.bad{border-left-color:var(--c-bug)}
  .qitem .qv{font-size:22px;font-weight:800;letter-spacing:-.02em}.qitem .ql{font-size:12.5px;color:var(--ink2);margin-top:3px}
  a.qitem{text-decoration:none;color:inherit;display:block}
  a.qitem:hover{box-shadow:var(--sh-lift);transform:translateY(-2px)}
  .qitem .qfix{margin-top:8px;font-size:12.5px;font-weight:700;color:var(--acc-ink)}
  .qitem .qfix.done{color:var(--good)}
  .qitem .qfix.muted{color:var(--mut);font-weight:500}
  .mini{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px;margin:8px 0 12px}
  .mini .m{background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:8px 10px}
  .mini .mv{font-size:21px;font-weight:700}.mini .ml{font-size:12px;color:var(--mut)}
  details.repo-details{border-top:1px solid var(--line);margin-top:12px;padding-top:10px}
  details.repo-details summary{cursor:pointer;color:var(--acc);font-weight:600;font-size:14px}
  .bar{height:9px;background:var(--panel2);border-radius:6px;overflow:hidden;margin-top:4px}
  .bar > i{display:block;height:100%}
  .row{display:flex;align-items:center;gap:10px;padding:5px 0;font-size:14px}
  .row .nm{flex:0 0 150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .row .bb{flex:1} .row .vv{flex:0 0 92px;text-align:right;color:var(--mut);font-variant-numeric:tabular-nums;white-space:nowrap}
  .split{display:flex;height:26px;border-radius:6px;overflow:hidden;margin:6px 0 2px}
  .split i{display:flex;align-items:center;justify-content:center;font-size:12px;color:#fff;font-weight:600}
  .tag{display:inline-block;font-size:11px;padding:1px 6px;border-radius:20px;border:1px solid var(--line);color:var(--mut);margin-left:6px}
  .tag.ext{color:var(--warn);border-color:#d4b75c}
  .tag.legacy{color:var(--app);border-color:#c4a7e7}
  .period-bar{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin:8px 0 0}
  .period-bar .period-lbl{font-size:11px;font-weight:700;color:var(--mut);margin-right:2px;
    text-transform:uppercase;letter-spacing:.05em}
  /* segmented control for the presets — one connected group, one active */
  .pseg{display:inline-flex;border:1px solid var(--line2);border-radius:999px;background:var(--panel);
    padding:4px;gap:2px;box-shadow:var(--sh)}
  .pchip{border:none;background:transparent;color:var(--ink2);
    border-radius:999px;padding:6px 14px;font:inherit;font-size:13px;font-weight:600;cursor:pointer}
  .pchip:hover{background:var(--panel2);color:var(--ink)}
  .pchip.active{background:var(--acc);color:#fff;box-shadow:0 2px 8px rgba(91,91,240,.35)}
  /* custom range tucked behind a toggle — revealed on click, not always shown */
  .pcustbtn{border:1px solid var(--line);background:var(--panel);color:var(--mut);border-radius:8px;
    padding:6px 12px;font:inherit;font-size:13px;font-weight:600;cursor:pointer}
  .pcustbtn:hover,.pcustbtn.on{border-color:var(--acc);color:var(--acc)}
  .period-custom{align-items:center;gap:6px}
  .period-custom:not([hidden]){display:inline-flex}
  .period-custom input{border:1px solid var(--line);border-radius:6px;
    padding:5px 8px;font:inherit;font-size:13px;background:var(--panel);color:var(--ink)}
  .period-custom .papply{border:1px solid var(--acc);background:var(--acc);color:#fff;border-radius:6px;
    padding:5px 11px;font:inherit;font-size:13px;font-weight:600;cursor:pointer}
  .period-note{font-size:12px;color:var(--mut);margin-left:2px}
  .period-legend{font-size:11.5px;color:var(--mut);margin-top:8px;line-height:1.5;opacity:.85}
  .period-legend b{font-weight:600;color:var(--mut)}
  /* the legend text is a disclosure: forced-open with the summary hidden on desktop,
     collapsed by default on mobile (JS drops the open attr) so it doesn't eat the screen */
  .period-legend>summary{display:none}
  .period-legend[open]>summary{margin-bottom:4px}
  @media(max-width:640px){
    .period-legend>summary{display:inline-flex;align-items:center;gap:5px;list-style:none;
      cursor:pointer;font-size:12px;font-weight:600;color:var(--acc);opacity:1}
    .period-legend>summary::-webkit-details-marker{display:none}
    .period-legend>summary::before{content:"▸";font-size:10px;transition:transform .15s}
    .period-legend[open]>summary::before{transform:rotate(90deg)}
    #slice-msg{display:none}  /* folded into the legend on mobile to save vertical space */
  }
  @media(min-width:901px){
    /* desktop: one row — slice pinned left, period pushed right; legend wraps below */
    .topbar{display:flex;flex-wrap:wrap;align-items:center;column-gap:20px}
    .topbar>.period-bar{margin:0}
    .topbar>[aria-label="Repository slice"]{order:1}
    .topbar>[aria-label="Period filter"]{order:2;margin-left:auto}
    .topbar>.period-legend{order:3;flex-basis:100%;margin-top:6px}
    #slice-msg{display:none}  /* redundant with the legend in the one-row layout */
  }
  .alltime-tag{font-size:11px;font-weight:600;color:var(--mut);border:1px solid var(--line);
    border-radius:999px;padding:1px 7px;vertical-align:middle;margin-left:6px}
  .pblock[hidden]{display:none}
  .period-tag{font-size:12px;font-weight:600;color:var(--acc);border:1px solid #aacbf0;
    border-radius:999px;padding:1px 8px;vertical-align:middle}
  table{width:100%;border-collapse:collapse;font-size:13.5px;font-variant-numeric:tabular-nums}
  th,td{padding:9px 10px;text-align:right;border-bottom:1px solid var(--line)}
  th:first-child,td:first-child{text-align:left}
  th{color:var(--mut);font-weight:700;font-size:11px;text-transform:uppercase;letter-spacing:.04em;
    border-bottom:1px solid var(--line2)}
  tbody tr:last-child td{border-bottom:none}
  tbody tr:hover{background:#f7f8fc}
  /* grouped per-person table: visual separators + group-header band */
  table.grouped th.g, table.grouped td.g{border-left:2px solid var(--line)}
  table.grouped tr.grp th{font-size:11px;text-transform:uppercase;letter-spacing:.04em;
    color:var(--mut);text-align:center;background:var(--panel2);border-bottom:1px solid var(--line);
    padding:5px 8px;font-weight:700}
  table.grouped tr.grp th:first-child{text-align:left}
  /* sticky first column so the person stays visible when scrolling the wide table right */
  table.grouped th:first-child,table.grouped td:first-child{position:sticky;left:0;
    background:var(--panel);box-shadow:1px 0 0 var(--line);z-index:2}
  table.grouped tr.grp th:first-child{background:var(--panel2);z-index:3}
  table.grouped tbody tr:nth-child(even) td:first-child{background:#f4f5f7}
  table.grouped tbody tr:hover td:first-child{background:#e9f2fc}
  table.grouped tbody tr.extra{display:none}
  table.grouped.expanded tbody tr.extra{display:table-row}
  .tblbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:0 0 10px}
  .tblbar input{flex:1 1 220px;max-width:340px;border:1px solid var(--line);border-radius:8px;
    padding:6px 10px;font:inherit;font-size:13px;background:var(--bg);color:var(--ink)}
  .tblbar button{border:1px solid var(--line);background:var(--panel);color:var(--ink);
    border-radius:999px;padding:5px 11px;font:inherit;font-size:13px;font-weight:600;cursor:pointer}
  .tblbar button:hover{border-color:var(--acc);color:var(--acc)}
  .tblbar .cnt{font-size:12px;color:var(--mut)}
  .person-select{border:1px solid var(--line);border-radius:8px;padding:6px 10px;
    font:inherit;font-size:13px;background:var(--bg);color:var(--ink);max-width:420px}
  .person-pick{font-size:13px;color:var(--mut);font-weight:600}
  .person-combo{position:relative;display:inline-block}
  .person-search{border:1px solid var(--line);border-radius:8px;padding:6px 30px 6px 10px;
    font:inherit;font-size:13px;background:var(--bg);color:var(--ink);width:320px;max-width:80vw}
  .person-search:focus{outline:none;border-color:var(--acc)}
  .person-clear{position:absolute;top:50%;right:6px;transform:translateY(-50%);border:none;
    background:transparent;color:var(--mut);font-size:17px;line-height:1;cursor:pointer;
    padding:2px 5px;border-radius:6px}
  .person-clear:hover{background:var(--panel2);color:var(--ink)}
  .combo-list{position:absolute;z-index:60;top:calc(100% + 4px);left:0;width:380px;max-width:86vw;
    max-height:320px;overflow-y:auto;background:var(--panel);border:1px solid var(--line);
    border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.12)}
  .combo-item{padding:7px 11px;cursor:pointer;border-bottom:1px solid var(--line);font-size:13px}
  .combo-item:last-child{border-bottom:none}
  .combo-item:hover{background:var(--panel2)}
  .combo-item .mut{color:var(--mut);font-size:12px}
  .combo-em{color:var(--mut);font-size:11px;margin-top:1px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .combo-empty{padding:8px 11px;color:var(--mut);font-size:12px}
  /* per-person weekly table: green additions, red deletions, numeric alignment */
  table.person-weekly td,table.person-weekly th{font-variant-numeric:tabular-nums}
  table.person-weekly .pw-lines{white-space:nowrap}
  table.person-weekly .pw-add{color:var(--good)} table.person-weekly .pw-del{color:var(--bad)}
  table.person-weekly tfoot .pw-tot td{border-top:2px solid var(--line);font-weight:700}
  table.person-weekly .mut{color:var(--mut)}
  /* ---- Person dashboard ---- */
  .pcard{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px 18px}
  .pcard h4{margin:0 0 10px;font-size:13px;font-weight:700;color:var(--mut);
    text-transform:uppercase;letter-spacing:.03em}
  .phead{display:flex;align-items:center;gap:16px;margin:4px 0 16px}
  .pav{width:60px;height:60px;border-radius:50%;flex:none;border:1px solid var(--line);background:var(--panel2)}
  .pname{font-size:20px;font-weight:800;letter-spacing:-.01em}
  .pname a{text-decoration:none;font-size:14px;font-weight:600}
  .pmeta{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
  .pemails{color:var(--mut);font-size:12px;margin-top:5px;word-break:break-all}
  .ghprof{padding:12px 16px;margin:0 0 16px}
  .ghprof-h{font-size:12px;font-weight:700;color:var(--mut);margin-bottom:8px}
  .ghprof-h .mut{font-weight:500}
  .ghprof-rows{display:flex;flex-wrap:wrap;gap:6px 22px;font-size:13px}
  .ghprof-rows .ghbio{flex-basis:100%;color:var(--ink)}
  .ghprof-rows .ghl{display:inline-block;min-width:64px;color:var(--mut);font-weight:600;margin-right:6px}
  .chip{display:inline-block;font-size:11px;font-weight:700;padding:2px 9px;border-radius:999px;
    background:var(--panel2);color:var(--ink);border:1px solid var(--line)}
  .chip.mem{background:rgba(9,105,218,.12);color:var(--acc);border-color:transparent}
  .chip.ext{background:rgba(154,103,0,.14);color:var(--warn);border-color:transparent}
  .chip.idc{background:rgba(26,127,55,.12);color:var(--good);border-color:transparent;text-transform:capitalize}
  .chip.rk{background:transparent;color:var(--mut)}
  .pkpis{margin:0 0 6px}
  .psec{font-size:16px;margin:26px 0 12px;padding-top:14px;border-top:1px solid var(--line);font-weight:700}
  .dsub{font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--mut);margin:14px 0 7px}
  .dwdot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:7px;vertical-align:middle}
  .pgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;align-items:start}
  .split2{display:flex;height:14px;border-radius:7px;overflow:hidden;background:var(--panel2)}
  .split2 i{display:block;height:100%}
  .leg2{display:flex;flex-wrap:wrap;gap:14px;margin-top:8px;font-size:12px;color:var(--mut)}
  .leg2 .sw{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px;vertical-align:middle}
  .edot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:7px;vertical-align:middle}
  .flowpipe{display:flex;align-items:stretch;gap:0;overflow-x:auto;padding:4px 2px 6px}
  .flowpipe .flow-arrow{flex:0 0 22px;display:flex;align-items:center;justify-content:center;color:var(--mut);font-size:16px}
  .flow-stage{flex:1 1 0;min-width:104px;border:1px solid var(--line);border-radius:12px;padding:12px 13px;background:var(--panel2)}
  .flow-stage.zero{opacity:.5}
  .flow-head{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:700;color:var(--ink2)}
  .flow-head .dot{width:9px;height:9px;border-radius:50%;flex:none}
  .flow-n{font-size:22px;font-weight:800;letter-spacing:-.02em;margin-top:6px}
  .flow-pct{font-size:11.5px;color:var(--mut);margin-top:1px}
  .flow-bar{height:6px;border-radius:4px;background:var(--panel);overflow:hidden;margin-top:9px}
  .flow-bar i{display:block;height:100%;border-radius:4px}
  /* Flow tab: friction explainer + health / cycle-time cards + per-person table */
  .flow-explain{margin-bottom:16px}
  .flow-explain h3{margin:0 0 8px}
  .flow-formula{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:10px 13px;font-size:13.5px;margin:8px 0}
  .flow-explain ul{margin:8px 0;padding-left:20px;font-size:13px;color:var(--ink2)}
  .flow-explain ul li{margin:3px 0}
  .flow-explain ul li b{color:var(--ink)}
  h3.sub{font-size:15px;margin:20px 0 10px;font-weight:750}
  h3.sub .mut{font-weight:400;font-size:12.5px}
  .flow-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
  .fcard{border:1px solid var(--line);border-radius:12px;padding:13px 15px;background:var(--panel)}
  .fcard-drill{cursor:pointer;transition:border-color .12s,background .12s}
  .fcard-drill:hover{border-color:var(--acc);background:var(--panel2)}
  .fc-n{font-size:24px;font-weight:800;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
  .fc-l{font-size:12.5px;font-weight:700;color:var(--ink2);margin-top:1px}
  .fc-s{font-size:11.5px;color:var(--mut);margin-top:4px}
  .flow-tbl td .dr,.flow-tbl td.fr{font-variant-numeric:tabular-nums}
  .flow-tbl td.fr{font-weight:800}
  .flow-tbl .dr[data-drill]{cursor:pointer;border-bottom:1px dashed var(--acc);color:var(--acc)}
  .statrow{display:flex;justify-content:space-between;gap:12px;padding:6px 0;border-bottom:1px solid var(--line);font-size:13px}
  .statrow:last-child{border-bottom:none}
  .statrow .sk{color:var(--mut)} .statrow .sv{font-weight:700;font-variant-numeric:tabular-nums}
  /* weekly activity heatmap strip */
  .heat{display:flex;flex-wrap:wrap;gap:3px;margin:0 0 14px}
  .heat .hc{width:13px;height:13px;border-radius:3px;background:var(--panel2);
    background:color-mix(in srgb,var(--acc) calc(var(--a,0)*100%),var(--panel2))}
  /* expandable "+N more" tails: clickable aggregate row + hidden detail rows */
  .row.more-row{cursor:pointer}
  .row.more-row .nm{color:var(--acc);font-weight:600}
  .row.more-row:hover .nm{text-decoration:underline}
  .more-tail{max-height:340px;overflow-y:auto}
  /* capped tables: tail rows behind a "Show all N" toggle row */
  table.capped tr.extra{display:none}
  table.capped.expanded tr.extra{display:table-row}
  tr.more td{color:var(--acc);cursor:pointer;font-weight:600;text-align:left}
  tr.more td:hover{text-decoration:underline}
  /* in-cell data bar: share-of-total behind the % value */
  td.db{background:linear-gradient(90deg,rgba(9,105,218,.16) var(--w,0%),transparent var(--w,0%))}
  /* in-cell heatmap: alpha scales with the value (AI% columns) */
  td.hm{background:rgba(130,80,223,var(--a,0))}
  /* zero / no-data cells fade back so real data pops (JS-tagged) */
  td.z{color:var(--mut);opacity:.45}
  .toc{columns:2;column-gap:28px;background:var(--panel);border:1px solid var(--line);
    border-radius:12px;padding:14px 18px;margin:16px 0 4px}
  .toc a{display:block;color:var(--acc);text-decoration:none;font-size:13px;
    padding:3px 0;break-inside:avoid}
  .toc a:hover{text-decoration:underline}
  @media(max-width:760px){.toc{columns:1}}
  #totop{position:fixed;right:18px;bottom:80px;z-index:60;display:none;
    border:1px solid var(--line);border-radius:999px;background:var(--panel);color:var(--mut);
    font:inherit;font-size:13px;font-weight:600;padding:7px 12px;cursor:pointer;
    box-shadow:0 2px 8px rgba(0,0,0,.12)}
  #totop.show{display:block}
  #totop:hover{color:var(--acc);border-color:var(--acc)}
  .pill{font-size:11px;padding:2px 7px;border-radius:20px;font-weight:600}
  .pill.member{background:#dafbe1;color:#116329}
  .pill.external{background:#fff8c5;color:#7d4e00}
  .pill.id{background:var(--panel2);color:var(--mut);white-space:nowrap}
  .pill.id.manual,.pill.id.verified,.pill.id.pr{background:#dafbe1;color:#116329}
  .pill.id.name,.pill.id.github{background:#fff8c5;color:#7d4e00}
  .pill.id.unresolved{background:#ffebe9;color:#cf222e}
  .chips span{display:inline-block;background:var(--panel2);border:1px solid var(--line);
    border-radius:6px;padding:2px 8px;margin:2px;font-size:13px}
  .trend{display:grid;grid-template-columns:80px 1fr;gap:7px 12px;align-items:center;margin:2px 0}
  .trend .lab{color:var(--mut);font-size:13px;text-align:right}
  /* Trend tab — stacked-area chart */
  .trendhead{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin:2px 0 12px}
  .trendctl{display:flex;align-items:center;flex-wrap:wrap;gap:8px}
  .granctl{display:inline-flex;border:1px solid var(--line2);border-radius:999px;background:var(--panel);padding:3px;gap:2px;box-shadow:var(--sh)}
  .gtog{border:none;background:transparent;color:var(--mut);border-radius:999px;padding:6px 11px;font:inherit;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap}
  .gtog:hover{background:var(--panel2);color:var(--ink)}
  .gtog.active{background:var(--panel2);color:var(--ink);box-shadow:inset 0 0 0 1px var(--line2)}
  .gtog .gres{color:var(--mut);font-weight:500}
  .gtog.active .gres{color:var(--acc)}
  .arealeg{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:12px;color:var(--ink2)}
  .arealeg .lg{display:inline-flex;align-items:center;gap:5px}
  .arealeg .lg i{width:10px;height:10px;border-radius:2px;display:inline-block}
  .trend-h{font-size:13px;font-weight:700;color:var(--ink2);margin:18px 0 4px;display:flex;align-items:center;gap:10px}
  .trend-h:first-of-type{margin-top:6px}
  /* Trend sub-sections: "Breakdown" (dim switcher scoped to its 2 stacked charts) and
     "Throughput & activity". Divider makes the switcher's scope unambiguous. */
  .trend-sec{border-top:1px solid var(--line);padding-top:6px;margin-top:22px}
  .trend-sec:first-of-type{border-top:none;padding-top:0;margin-top:0}
  .trend-sechead{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin:2px 0 8px}
  .trend-secttl{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--mut);margin:0}
  .trend-sec > .trend-secttl{margin-bottom:2px}
  .trend-sec .trend-h:first-of-type{margin-top:10px}
  .trend-leg{font-size:11px;font-weight:600;color:var(--mut);display:inline-flex;gap:10px;align-items:center}
  .trend-leg i{width:9px;height:9px;border-radius:2px;display:inline-block;margin-right:3px;vertical-align:middle}
  .areawrap[hidden]{display:none}
  {{ chart_css|safe }}
  /* weekly-activity small multiples: one mini line chart per metric, own scale */
  .wkgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px 22px}
  @media(max-width:760px){.wkgrid{grid-template-columns:1fr}}
  .wkcell-h{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:2px}
  .wkcell-t{font-size:13px;font-weight:700;color:var(--ink2)}
  .wkcell-n{font-size:12px;font-weight:700;color:var(--mut);font-variant-numeric:tabular-nums}
  .wtbar{margin:2px 0 14px}
  .wtsw{width:10px;height:10px;border-radius:2px;display:inline-block;margin-right:7px;vertical-align:middle;flex:none}
  /* Developer score (experimental, collapsed on the Person tab) */
  .dsc{margin-top:18px;border:1px solid var(--line);border-radius:12px;background:var(--panel);overflow:hidden}
  .dsc>summary{cursor:pointer;padding:12px 16px;font-weight:700;font-size:14px;list-style:none;display:flex;align-items:center;gap:8px}
  .dsc>summary::-webkit-details-marker{display:none}
  .dsc>summary::before{content:"▸";color:var(--mut);font-size:11px;transition:transform .15s}
  .dsc[open]>summary::before{transform:rotate(90deg)}
  .dsc .mut{color:var(--mut);font-weight:500}
  .dsc-exp{font-size:10px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:#c77700;
    background:#f59e0b22;border:1px solid #f59e0b55;border-radius:999px;padding:1px 7px}
  .dsc-body{padding:2px 16px 16px}
  .dsc-top{display:grid;grid-template-columns:150px 1fr;gap:24px;align-items:start}
  @media(max-width:640px){.dsc-top{grid-template-columns:1fr}}
  .dsc-gauge{text-align:center}
  .dsc-val{font-size:30px;font-weight:850;fill:var(--ink)}
  .dsc-of{font-size:10px;fill:var(--mut)}
  .dsc-band{font-weight:750;font-size:13px;margin-top:4px}
  .dsc-pil{margin:0 0 11px}
  .dsc-pil-h{display:flex;align-items:baseline;gap:8px}
  .dsc-pil-n{font-size:13px;font-weight:700}
  .dsc-wt{font-size:10.5px;color:var(--mut)}
  .dsc-wt.dsc-na{font-style:italic}
  .dsc-pil.na .dsc-pil-n{color:var(--mut)}
  .dsc-sc{margin-left:auto;font-size:14px;font-weight:800}
  .dsc-track{height:7px;border-radius:5px;background:var(--panel2);overflow:hidden;margin:4px 0 3px}
  .dsc-fill{height:100%;border-radius:5px}
  .dsc-i{width:15px;height:15px;flex:none;border-radius:50%;border:1px solid var(--line);
    background:var(--panel2);color:var(--mut);font:italic 700 10px/13px Georgia,serif;
    cursor:pointer;padding:0;text-align:center}
  .dsc-i:hover{border-color:var(--acc);color:var(--acc)}
  .dsc-i.on{background:var(--acc);color:#fff;border-color:var(--acc)}
  .dsc-why{font-size:11.5px;line-height:1.5;color:var(--ink2);background:var(--panel2);
    border-radius:8px;padding:8px 11px;margin:4px 0 2px}
  .dsc-why[hidden]{display:none}
  .dsc-drv{font-size:11.5px;color:var(--mut)}
  /* make the drillable driver numbers read as links, not muted caption text */
  .dsc-drv .dr[data-drill]{color:var(--acc);cursor:pointer;font-weight:600;
    text-decoration:underline dotted color-mix(in srgb,var(--acc) 45%,transparent);text-underline-offset:2px}
  .dsc-drv .dr[data-drill]:hover{text-decoration-color:var(--acc)}
  .dsc-ctx{margin-top:8px;font-size:11.5px;color:var(--mut);display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .dsc-chip{font-size:11px;font-weight:700;color:var(--acc);background:var(--acc-soft,#edecfe);border-radius:999px;padding:2px 9px}
  .dsc-board{margin-top:16px;border-top:1px solid var(--line);padding-top:12px}
  .dsc-board-h{font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--ink2);margin-bottom:6px}
  .dsc-val,.dsc-sc{font-variant-numeric:tabular-nums}
  /* why-this-rank line + the real-work → team → score chain (card & row expansions) */
  .dsc-whyrank{font-size:12.5px;color:var(--ink2);margin:0 0 9px;line-height:1.45}
  .dsc-whyrank.dsc-selfrow{color:var(--acc);font-weight:700}
  .dsc-chain{width:100%;border-collapse:collapse;font-size:12px}
  .dsc-chain th{font-size:10px;text-transform:uppercase;letter-spacing:.03em;color:var(--mut);font-weight:700;text-align:left;padding:0 8px 4px 0;border-bottom:1px solid var(--line)}
  .dsc-chain td{padding:5px 8px 5px 0;border-bottom:1px solid var(--line);vertical-align:baseline}
  .dsc-chain tr.off{opacity:.55}
  .dsc-chain td.pil{font-weight:700;white-space:nowrap}
  .dsc-chain td.pil .w{font-weight:600;color:var(--mut);font-size:10.5px}
  .dsc-chain td.work{color:var(--ink)}
  .dsc-chain td.vs{color:var(--mut);white-space:nowrap}
  .dsc-chain td.sp{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
  .dsc-chain td.sp b{font-weight:800}
  .dsc-chain td.sp .ar{color:var(--mut);margin-left:5px}
  .dsc-chain tr.gap td.work,.dsc-chain tr.gap td.sp b{color:#ef4444}
  .dsc-chain tr.tot td{border-bottom:none;font-weight:800;padding-top:7px}
  .dsc-chain tr.tot td.sp b{font-size:15px}
  .dsc-leg{display:flex;flex-wrap:wrap;gap:12px;margin:2px 0 8px;font-size:11px;color:var(--mut)}
  .dsc-leg .dsc-legi{display:inline-flex;align-items:center;gap:5px}
  .dsc-leg i{width:10px;height:10px;border-radius:3px;display:inline-block}
  .dsc-drow{border-top:1px solid var(--line)}
  .dsc-drow.me{background:var(--acc-soft,#edecfe)}
  .dsc-drow summary{display:grid;grid-template-columns:26px 1fr 130px 40px;align-items:center;gap:12px;
    padding:7px 8px;cursor:pointer;list-style:none}
  .dsc-drow summary::-webkit-details-marker{display:none}
  .dsc-drow summary:hover{background:var(--panel2,#eaeef2)}
  .dsc-drow summary .rk{font-size:12px;color:var(--mut);font-weight:700;text-align:center;font-variant-numeric:tabular-nums}
  .dsc-drow summary .nm{font-size:13.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .dsc-drow summary .comp{display:flex;height:14px;border-radius:4px;overflow:hidden;background:var(--panel2);cursor:help}
  .dsc-drow summary .comp i{display:block;height:100%}
  .dsc-drow summary .sc{font-size:15px;font-weight:850;text-align:right;font-variant-numeric:tabular-nums}
  .dsc-drow[open] summary{background:var(--panel2,#eaeef2)}
  .dsc-drow-body{padding:8px 10px 14px 46px}
  .dsc-rows.capped > .dsc-drow:nth-child(n+16){display:none}
  /* segbar component — a stacked proportional bar + optional swatch legend */
  .segbar{display:flex;width:100%;border-radius:4px;overflow:hidden;background:var(--panel2)}
  .segbar i{display:block;height:100%}
  .segleg{display:flex;flex-wrap:wrap;gap:14px;font-size:11.5px;color:var(--mut);margin-top:8px}
  .segleg span{display:inline-flex;align-items:center;gap:5px}
  .segleg i{width:10px;height:10px;border-radius:3px;display:inline-block} .segleg b{color:var(--ink)}
  /* Overview team-score rollup — built from segbar / data_table / kpi_tile */
  .scorecard{max-width:none;margin-top:38px}
  .scorecard h2{font-size:16px;font-weight:800;margin:0 0 3px}
  .scorecard .segbar{margin-top:12px}
  .sc-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:18px}
  @media(max-width:680px){.sc-grid{grid-template-columns:1fr}}
  .sc-h{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--ink2);margin-bottom:6px}
  .scorecard .dt td.sc-mk,.scorecard .dt th.sc-mk{width:130px}
  .sc-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(116px,1fr));gap:8px}
  .dsc-showall{margin-top:8px;font-size:12px;font-weight:700;color:var(--acc);background:none;
    border:1px solid var(--line);border-radius:8px;padding:6px 12px;cursor:pointer}
  .dsc-showall:hover{border-color:var(--acc)}
  .cols{display:flex;gap:3px;align-items:flex-end;height:40px}
  .cols .c{flex:1;background:var(--acc);border-radius:2px 2px 0 0;min-height:1px;opacity:.85}
  .wkaxis{display:flex;gap:3px;color:var(--mut);font-size:11px}
  .wkaxis span{flex:1;text-align:center;overflow:hidden}
  [data-tip]{cursor:help}
  .row .nm[data-tip]:hover, td[data-tip]:hover{text-decoration:underline dotted var(--mut)}
  #tip{position:fixed;z-index:9999;max-width:340px;background:#1f2328;color:#fff;
    padding:6px 9px;border-radius:6px;font-size:12px;line-height:1.5;white-space:pre-line;
    box-shadow:0 4px 14px rgba(0,0,0,.25);pointer-events:none;display:none}
  .conc{font-size:12px;color:var(--mut);margin:2px 0 8px}
  .conc b{color:var(--ink)}
  .prec{font-size:10px;padding:1px 5px;border-radius:10px;margin-left:6px;border:1px solid;white-space:nowrap}
  .prec.exact{color:#1a7f37;border-color:#a0d8b0;background:#eafff0}
  .prec.heuristic{color:#9a6700;border-color:#e8d8a0;background:#fff8e6}
  .cmix{max-width:680px}
  .cmix-bar{display:flex;height:18px;border-radius:9px;overflow:hidden;background:var(--panel2);margin-bottom:22px}
  .cmix-bar i{display:block;height:100%;transition:width .3s}
  .cmix-bar i[data-drill]{cursor:pointer} .cmix-bar i[data-drill]:hover{filter:brightness(1.08)}
  .cmix-stats{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:16px}
  @media(max-width:560px){.cmix-stats{grid-template-columns:1fr}}
  .cmix-stat{display:flex;align-items:baseline;gap:9px;padding:13px 16px;
    border:1px solid var(--line);border-radius:var(--r-sm);background:var(--panel);box-shadow:var(--sh)}
  .cmix-stat[data-drill]{cursor:pointer;transition:border-color .12s,box-shadow .12s}
  .cmix-stat[data-drill]:hover{border-color:var(--acc);box-shadow:var(--sh-lift)}
  .cmix-stat .sw{width:12px;height:12px;border-radius:3px;flex:0 0 auto;align-self:center}
  .cmix-pct{font-size:26px;font-weight:800;letter-spacing:-.02em;line-height:1}
  .cmix-lbl{font-size:14px;font-weight:600;color:var(--ink2)}
  .cmix-cnt{margin-left:auto;font-size:12.5px;color:var(--mut);white-space:nowrap}
  .cmix-note{font-size:12.5px;line-height:1.55;color:var(--mut);margin:0}
  .cmix-note b{font-weight:700}
  .mixbar{display:flex;height:9px;width:90px;border-radius:5px;overflow:hidden;background:var(--panel2)}
  .mixbar i{display:block;height:100%}
  .foot{color:var(--mut);font-size:13px;margin-top:30px;border-top:1px solid var(--line);padding-top:14px}
  .legend{font-size:13px;color:var(--mut);margin:8px 0}
  .legend b.p{color:var(--plat)} .legend b.a{color:var(--app)}
  a.gh{color:var(--acc);font-weight:600;text-decoration:none}
  a.gh:hover{text-decoration:underline}
  /* slim indeterminate top progress bar shown while any panel fetch is in flight —
     the report renders/filters live, so this signals "loading", not "broken" */
  #loadbar{position:fixed;top:0;left:0;right:0;height:3px;z-index:9999;background:transparent;
    opacity:0;transition:opacity .15s;pointer-events:none}
  #loadbar.on{opacity:1}
  #loadbar::before{content:"";position:absolute;top:0;height:100%;width:35%;border-radius:0 3px 3px 0;
    background:var(--acc);animation:loadbar 1.05s ease-in-out infinite}
  @keyframes loadbar{0%{left:-35%}100%{left:100%}}
  @media (prefers-reduced-motion:reduce){ #loadbar::before{animation:none;left:0;width:100%;opacity:.55} }
  /* sortable data_table headers (sort by each cell's data-sort raw value) */
  table.dt th.sortable{cursor:pointer;user-select:none;white-space:nowrap}
  table.dt th.sortable::after{content:"\2195";margin-left:4px;opacity:.3;font-size:11px}
  table.dt th[aria-sort="ascending"]::after{content:"\25B2";opacity:.7}
  table.dt th[aria-sort="descending"]::after{content:"\25BC";opacity:.7}

  /* --- Metrics assistant (live portal only; injected by JS, so it's absent in the
     emailed copy where scripts are stripped) --- */
  #mx-fab{position:fixed;right:18px;bottom:18px;z-index:61;width:52px;height:52px;
    border-radius:999px;border:none;background:var(--acc);color:#fff;cursor:pointer;
    box-shadow:var(--sh-lift);display:flex;align-items:center;justify-content:center;
    transition:transform .15s ease,filter .15s ease}
  #mx-fab:hover{filter:brightness(1.06);transform:translateY(-1px)}
  #mx-fab svg{width:24px;height:24px;stroke:#fff;fill:none;stroke-width:2}
  #mx-fab.hide{display:none}
  #mx-panel{position:fixed;right:18px;bottom:18px;z-index:62;width:390px;
    max-width:calc(100vw - 36px);height:min(72vh,600px);display:none;flex-direction:column;
    background:var(--panel);border:1px solid var(--line2);border-radius:var(--r);
    box-shadow:var(--sh-lift);overflow:hidden}
  #mx-panel.open{display:flex}
  /* Expanded to ~80% of the viewport, centred. */
  #mx-panel.max{width:80vw;height:80vh;left:10vw;top:10vh;right:auto;bottom:auto;max-width:none}
  .mx-head{display:flex;align-items:center;gap:8px;padding:12px 14px;border-bottom:1px solid var(--line)}
  .mx-head .mx-t{font-weight:800;letter-spacing:-.02em;font-size:14px}
  .mx-head .mx-sub{color:var(--mut);font-size:11px;font-weight:600}
  .mx-head .mx-exp{margin-left:auto;border:none;background:none;color:var(--mut);cursor:pointer;
    font-size:15px;line-height:1;padding:3px 7px;border-radius:8px}
  .mx-head .mx-x{border:none;background:none;color:var(--mut);cursor:pointer;
    font-size:20px;line-height:1;padding:2px 7px;border-radius:8px}
  .mx-head .mx-exp:hover,.mx-head .mx-x:hover{background:var(--panel2);color:var(--ink)}
  /* When expanded, let message bubbles use more of the width. */
  #mx-panel.max .mx-msg{max-width:70%}
  .mx-body{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px}
  .mx-msg{max-width:85%;padding:8px 11px;border-radius:12px;font-size:13.5px;line-height:1.5;
    white-space:pre-wrap;word-wrap:break-word;overflow-wrap:anywhere}
  .mx-msg.user{align-self:flex-end;background:var(--acc);color:#fff;border-bottom-right-radius:4px}
  .mx-msg.bot{align-self:flex-start;background:var(--panel2);color:var(--ink);border-bottom-left-radius:4px}
  .mx-msg.err{align-self:flex-start;background:var(--bad-bg);color:var(--bad);border:1px solid var(--bad)}
  .mx-msg.bot p{margin:0 0 8px} .mx-msg.bot p:last-child,.mx-msg.bot ul:last-child,.mx-msg.bot ol:last-child{margin-bottom:0}
  .mx-msg.bot ul,.mx-msg.bot ol{margin:4px 0 8px;padding-left:20px} .mx-msg.bot li{margin:2px 0}
  .mx-msg.bot code{background:rgba(16,24,40,.06);border-radius:5px;padding:1px 5px;font-size:12.5px;
    font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
  .mx-msg.bot strong{font-weight:700} .mx-msg.bot a{color:var(--acc-ink);text-decoration:underline}
  .mx-msg.bot table{border-collapse:collapse;margin:4px 0 8px;font-size:12px;display:block;
    overflow-x:auto;max-width:100%}
  .mx-msg.bot th,.mx-msg.bot td{border:1px solid var(--line2);padding:3px 7px;text-align:left;
    white-space:nowrap;vertical-align:top}
  .mx-msg.bot thead th{background:var(--panel2);font-weight:700}
  .mx-tool{align-self:flex-start;font-size:11px;color:var(--mut);font-weight:600}
  .mx-tool code{background:var(--panel2);border-radius:6px;padding:1px 5px;font-size:10.5px;margin-left:3px}
  .mx-empty{color:var(--mut);font-size:12.5px;text-align:center;margin:auto;max-width:250px}
  .mx-foot{border-top:1px solid var(--line);padding:10px;display:flex;gap:8px;align-items:flex-end}
  .mx-foot textarea{flex:1;resize:none;border:1px solid var(--line2);border-radius:10px;
    padding:8px 10px;font:inherit;font-size:13.5px;max-height:120px;background:var(--bg);color:var(--ink)}
  .mx-foot textarea:focus{outline:none;border-color:var(--acc)}
  .mx-foot button{border:none;background:var(--acc);color:#fff;border-radius:10px;padding:8px 14px;
    font:inherit;font-weight:700;cursor:pointer}
  .mx-foot button:disabled{opacity:.5;cursor:default}
  @media(max-width:480px){ #mx-panel{width:calc(100vw - 24px);right:12px;bottom:12px;height:min(80vh,600px)} }
</style>
{{ vega_scripts|safe }}
</head>
<body>
<div id="loadbar" role="progressbar" aria-hidden="true"></div>
<div class="app">
{{ sidebar|safe }}
<main class="wrap">

{% from 'panels' import gh, data_table, panel_kpis, panel_companies, panel_categories, panel_worktype, panel_commitmix, panel_score, panel_elements, panel_split, panel_weekly, panel_trend, panel_people, panel_traffic, panel_aiusage, panel_bots, panel_reviews, panel_delivery_kpis, panel_delivery_ci, panel_delivery_pr, panel_delivery_mix, panel_delivery_flow, panel_flow with context %}

<p class="sub">Org <b>{{meta.org}}</b> · {% if meta.all_time %}<b>all-time history</b> (since {{meta.window_start}}){% else %}window {{meta.window_start}} → today ({{meta.lookback_days}} days){% endif %} · generated {{generated[:16].replace("T"," ")}} UTC</p>
{% set pr = all_block %}{# build-time = all-time; /api/period swaps each [data-period-panel] for a window block #}

<div class="topbar">
{% set plabels = {'7d':'7 days','30d':'30 days','90d':'90 days','365d':'1 year','all':all_label} %}
<div class="period-bar" aria-label="Period filter">
  <span class="period-lbl">Period</span>
  <div class="pseg" role="group" aria-label="Preset windows">
    {% for lbl in window_labels %}<button type="button" class="pchip{{ ' active' if lbl == 'all' }}" data-pchip="{{lbl}}" onclick="setPeriod('{{lbl}}')">{{ plabels.get(lbl, lbl) }}</button>{% endfor %}
  </div>
  <button type="button" class="pcustbtn" id="pcustbtn" onclick="toggleCustom()">Custom…</button>
  <span class="period-custom" id="period-custom" hidden>
    <input id="pfrom" type="date" aria-label="from date"> –
    <input id="pto" type="date" aria-label="to date">
    <button type="button" class="papply" onclick="applyRange()">Apply</button></span>
  <span id="period-msg" class="period-note"></span>
</div>
<div class="period-bar" aria-label="Repository slice">
  <span class="period-lbl">Slice</span>
  <select id="global-scope" onchange="setScope(this.value)" style="padding:8px 14px;border:1px solid var(--line2);border-radius:999px;background:var(--panel);color:var(--ink2);font:inherit;font-size:13px;font-weight:600;max-width:280px;box-shadow:var(--sh);cursor:pointer">
    <option value="">Whole org — all repositories</option>
    {% if scope_targets.org %}<optgroup label="Organizations">{% for o in scope_targets.org %}<option value="org:{{o|e}}">{{o}}</option>{% endfor %}</optgroup>{% endif %}
    {% if scope_targets.element %}<optgroup label="Elements">{% for e in scope_targets.element %}<option value="element:{{e|e}}">{{e}}</option>{% endfor %}</optgroup>{% endif %}
    {% if scope_targets.repo %}<optgroup label="Repositories">{% for r in scope_targets.repo %}<option value="repo:{{r|e}}">{{r}}</option>{% endfor %}</optgroup>{% endif %}
  </select>
  <span class="period-note" id="slice-msg">scopes every windowed panel; all-time panels (Contributors, Surviving-LOC) stay org-wide</span>
</div>
<details class="period-legend" id="legendDisc" open>
  <summary>What the period &amp; slice affect</summary>
  <div class="legend-body">
    <b>Period-filtered:</b> KPIs · by company · % by category · work type ·
    By Element · platform/app · weekly activity · contribution trend · per-person activity · traffic ·
    code review · bot activity · AI-marked share · per-tool AI split.
    <b>Always all-time</b> (by nature): contributors (cumulative) · surviving-LOC ·
    repo coverage · content markers (Studio/Gears) · cpt lines.
    <b>Slice</b> scopes every windowed panel; all-time panels stay org-wide.
  </div>
</details>
</div>
{# All-tab table of contents — populated by JS from the section h2s #}
<div class="mode-section" data-modes="all">
  <nav id="toc" class="toc" aria-label="Report sections"></nav>
</div>

<div class="mode-section" data-modes="person">
<h2 id="person">Per-person weekly activity <span class="period-tag" data-period-tag></span></h2>
<div class="card">
  <div class="tblbar">
    <label class="person-pick">Company&nbsp;
      <select id="person-company" class="person-select">
        <option value="">All companies</option>
        {% for co in person_companies %}<option value="{{co}}">{{co}}</option>{% endfor %}
      </select>
    </label>
    <span class="person-combo">
      <input type="hidden" id="person-select">
      <input type="text" id="person-search" class="person-search" autocomplete="off"
             placeholder="Search person — name, login, or email…" aria-label="Search person">
      <button type="button" id="person-clear" class="person-clear" hidden aria-label="Clear selection" title="Clear">×</button>
      <div id="person-list" class="combo-list" hidden></div>
    </span>
    <span class="cnt">weeks bucketed by author date · Lines = git diff +/- · Issues = opened by author</span>
  </div>
  <script type="application/json" id="person-data">{{ person_options|tojson }}</script>
  <div id="person-view"><p class="hint">Pick a person to see their weekly commits / lines / issues for the selected period. Needs the portal (computed on the fly).</p></div>
</div>
</div>

{% if data_quality.api_rate_limited %}
<div class="mode-section" data-modes="overview repos elements usage people fabric all">
  <div class="card" style="border-color:var(--bad);background:#fff5f5">
    <p style="margin:0;color:var(--bad);font-weight:600">⚠ GitHub API rate limit hit during collection — this report is PARTIAL.{% if data_quality.api_reset %} Quota resets at {{data_quality.api_reset}}.{% endif %} Re-run collection after the reset for complete data.</p>
  </div>
</div>
{% endif %}

<div class="mode-section" data-modes="overview all">
<div data-period-panel="kpis">{{ panel_kpis(pr) }}</div>

<details class="readme" aria-label="Metric definitions">
  <summary>How to read these numbers</summary>
  <div>
    <div class="defs">
      <div class="def"><b>Meaningful LOC</b><span>Raw git additions minus generated, vendor, dependency, fixture, lockfile, build and binary paths. This is a cleaner code-volume signal, not a productivity score.</span></div>
      <div class="def"><b>Raw additions</b><span>Everything reported by git across cloned repositories before filtering. Kept in tooltips for auditability.</span></div>
      <div class="def"><b>Identity confidence</b><span>How a person was resolved: manual review, verified email/name bridge, GitHub login, or unresolved.</span></div>
    </div>
    <p class="conc" style="margin:10px 0 0">All counts are <b>created/opened in the window</b> (PRs also show how many later merged). Full status lifecycle — bugs resolved/verified/declined, PRs approved/rejected — is a planned next step (needs closed-issue/review queries).</p>
  </div>
</details>

</div>

<div class="mode-section" data-modes="delivery all">
<h2 id="delivery">Delivery — issues, PRs, CI &amp; workflow <span class="period-tag" data-period-tag></span></h2>

<h3 class="psec">Issues</h3>
<div data-period-panel="delivery-kpis">{{ panel_delivery_kpis(pr) }}</div>
<div class="dsub">By category</div>
<div class="card" data-period-panel="delivery-mix">{{ panel_delivery_mix(pr) }}</div>

<h3 class="psec" style="margin-top:26px">Pull requests</h3>
<div data-period-panel="delivery-pr">{{ panel_delivery_pr(pr) }}</div>

<h3 class="psec" style="margin-top:26px">CI &amp; gates</h3>
<div data-period-panel="delivery-ci">{{ panel_delivery_ci(pr) }}</div>

<h3 class="psec" style="margin-top:26px">Workflow — current board state <span class="alltime-tag">now</span></h3>
<div class="card" data-period-panel="delivery-flow">{{ panel_delivery_flow(pr) }}</div>
<p class="conc" style="margin-top:8px">How work <b>moves</b> and how long it takes — cumulative flow, time in stage, QA→dev returns — lives on the <a href="#flow">Flow</a> tab.</p>

<p class="conc" style="margin-top:16px">Categories, stages and CI roles come from the <a href="/semantic">Taxonomy</a> resolved per item's element/repo. Unmapped items fall into <code>uncategorized</code> — refine the mapping to sharpen these.</p>
</div>

<div class="mode-section" data-modes="flow all">
<h2 id="flow">Flow &amp; friction <span class="period-tag" data-period-tag></span></h2>
<div data-period-panel="flow">{{ panel_flow(pr) }}</div>
</div>

<div class="mode-section" data-modes="repos all">
<h2 id="repo-coverage">Repo coverage <span class="alltime-tag">all-time</span></h2>
<div class="card">
  <p class="hint">Repository inventory and coverage health. Detailed repo rows are collapsed because this is a trust/context section, not the main story.</p>
  <div class="mini">
    <div class="m"><div class="mv">{{repo_summary.distinct}}</div><div class="ml">distinct repos</div></div>
    <div class="m"><div class="mv">{{repo_summary.primary}}</div><div class="ml">in {{repo_summary.primary_org}} (primary)</div></div>
    <div class="m"><div class="mv">{{repo_summary.legacy_only}}</div><div class="ml">legacy-only (old org)</div></div>
    <div class="m"><div class="mv">{{repo_summary.platform}}</div><div class="ml">platform</div></div>
    <div class="m"><div class="mv">{{repo_summary.app}}</div><div class="ml">app</div></div>
    <div class="m"><div class="mv">{{repo_summary.unclassified}}</div><div class="ml">unclassified</div></div>
    <div class="m"><div class="mv">{{repo_summary.missing_traffic}}</div><div class="ml">missing traffic access</div></div>
  </div>
  <p class="conc"><b>{{repo_summary.distinct}} distinct repos</b> = {{repo_summary.primary}} in <code>{{repo_summary.primary_org}}</code> (primary) + {{repo_summary.legacy_only}} legacy-only in the old org.
    {% if repo_summary.legacy_dup %}A further <b>{{repo_summary.legacy_dup}}</b> old-org repos are pre-migration copies of primary repos (same name in both orgs) — the inventory below lists all {{repo_summary.total}} org/name pairs, but commits &amp; LOC are parsed from the primary org only, so migrated repos are not double-counted for code.{% endif %}</p>
  {% if unclassified %}
  <p class="conc"><b>Needs classification:</b>
    {% for r in unclassified %}<span class="tag">{{r}}</span>{% endfor %}
  </p>
  {% endif %}
  <details class="repo-details">
    <summary>Show repo inventory table ({{repo_rows|length}} repos)</summary>
    <div style="overflow-x:auto;margin-top:10px">
    {% set REPO_COLS = [
      {'label':'Repo', 'kind':'text', 'key':'name', 'tags':[
        {'if_key':'unclassified', 'text':'unclassified'},
        {'if_key':'legacy_only', 'text':'legacy-only', 'cls':'legacy', 'tip':'Exists only in the legacy org — never migrated to the primary org'}]},
      {'label':'Org', 'kind':'text', 'key':'org'},
      {'label':'Class', 'kind':'text', 'key':'classification'},
      {'label':'Element', 'kind':'text', 'key':'element'},
      {'label':'Code LOC', 'tip':"surviving code lines in today's tree (blame); — = not cloned", 'key':'code_loc', 'kind':'loc', 'dash':true},
      {'label':'Spec LOC', 'tip':"surviving spec lines in today's tree (blame)", 'key':'spec_loc', 'kind':'loc', 'dash':true},
      {'label':'Contributors', 'key':'contributors', 'fmt':'raw'},
      {'label':'Forks', 'key':'forks', 'fmt':'raw'},
      {'label':'Stars', 'key':'stars', 'fmt':'raw'},
      {'label':'Traffic', 'kind':'bool', 'key':'traffic_access', 'bool_map':{'true':'yes', 'false':'no access'}},
      {'label':'Clones', 'key':'clones'},
      {'label':'Unique cloners', 'key':'uniques'},
    ] %}
    {{ data_table(REPO_COLS, repo_rows, cap=60) }}
    </div>
  </details>
</div>
</div>

<div class="mode-section" data-modes="elements all">
<h2 id="elements">By Element</h2>
<div class="card">
  <p class="hint">Product-line rollup. <b>Code/Spec LOC</b> = surviving lines in
    today's tree (git blame), specs counted separately from code; computable for
    cloned primary-org repos only — <span class="alltime-tag">all-time</span>, not
    period-filtered. <b>Commits, PRs, people and AI%</b> reflect the selected period.</p>
  <div data-period-panel="elements">{{ panel_elements(pr) }}</div>
  <p class="conc">Element mapping lives in <code>config.yaml</code> under <code>elements:</code>.
    Old-org (<code>your-old-org</code>) repos contribute PR/people metadata to their
    element but no LOC (not cloned).</p>
</div>
</div>

{% if contrib_block %}
<div class="mode-section" data-modes="overview all">
<h2 id="contributors">Contributors <span class="alltime-tag">cumulative · all-time</span></h2>
<div class="card">
  <p class="hint">Distinct people with any commit / PR / issue (bots &amp; migration duplicates excluded), counted cumulatively. Δ = change over the last 90 days (since {{contrib_block.since}}). Not affected by the period filter above.</p>
  <div class="kpis">
    {% for t in contrib_block.tiles %}
    <div class="kpi"><div class="n" style="color:{{t.color}}">{{t.now}}</div><div class="l">{{t.label}}</div>
      <div class="l2">{{ "+" if t.delta > 0 else "" }}{{t.delta}} in 90d</div></div>
    {% endfor %}
  </div>
  <div class="trendhead" style="margin-top:14px">
    <h3 class="trend-h" style="margin:0">Cumulative contributors by month</h3>
    <div class="arealeg">{% for s in contrib_block.series %}<span class="lg"><i style="background:{{s.color}}"></i>{{s.name}}</span>{% endfor %}</div>
  </div>
  <div class="areawrap">{{ line_chart(contrib_block.series, contrib_block.dates, '') }}</div>
</div>
</div>
{% endif %}

<div class="mode-section" data-modes="overview all">
<h2 id="companies">Contribution by company <span class="period-tag" data-period-tag></span></h2>
<div class="card">
  <div data-period-panel="companies">{{ panel_companies(pr) }}</div>
  <p class="conc">Affiliation = email domain (example.com / example.net → Constructor, partner.example → Example Inc) or a manual <code>companies.overrides</code> in config; unmapped → <b>Other</b>. People with no commit-email are mapped by login override only. Bar = share of commits.</p>
</div>
</div>

<div class="mode-section" data-modes="fabric all">
<h2 id="ai-usage">Made with AI tools <span class="period-tag" data-period-tag></span></h2>
<div class="card">
  <div data-period-panel="aiusage">{{ panel_aiusage(pr) }}</div>
</div>
</div>

{% if studio_prov.markers %}
<div class="mode-section" data-modes="fabric all">
<h2 id="studio-provenance">Content provenance — content markers <span class="alltime-tag">all-time</span></h2>
<div class="card">
  <p class="hint">Scanned from <b>full repo content</b> (git grep over the default-branch tree), not commit messages — these markers are functional and not casually stripped, so this is the strongest in-repo provenance signal. Snapshot of current content (not windowed).</p>
  <div class="mini">
    {% for m in studio_prov.markers %}
    <div class="m"><div class="mv">{{studio_prov.totals[m].files}}</div><div class="ml">{{m}} — files ({{studio_prov.totals[m].lines}} lines)</div></div>
    {% endfor %}
  </div>
  <div class="card" style="overflow-x:auto;border:none;padding:0;margin-top:10px"><table class="dt">
    <tr><th class="sortable">Repo</th>{% for m in studio_prov.markers %}{% set pr=(studio_prov.precision or {}).get(m,'exact') %}<th class="sortable">{{m}} <span class="prec {{pr}}">{{pr}}</span> (files / lines)</th>{% endfor %}</tr>
    {% for repo, vals in studio_prov.by_repo.items() %}
    <tr><td data-sort="{{ repo.split("/")[-1]|e }}">{{ repo.split("/")[-1] }}</td>
      {% for m in studio_prov.markers %}<td data-sort="{{ vals[m].files if vals.get(m) else 0 }}">{{ vals[m].files if vals.get(m) else 0 }} / {{ vals[m].lines if vals.get(m) else 0 }}</td>{% endfor %}
    </tr>
    {% endfor %}
    {% if not studio_prov.by_repo %}<tr><td colspan="{{studio_prov.markers|length + 1}}" class="muted">No content markers found.</td></tr>{% endif %}
  </table></div>
  {% if cpt_by_company %}
  <h3 style="margin-top:16px">assistant code-marker lines — by company (git blame)</h3>
  <div class="split">
    {% set cpt_total = cpt_by_company|sum(attribute='lines') %}
    {% for c in cpt_by_company %}<i style="width:{{ (100*c.lines/cpt_total)|round(1) }}%;background:{{c.color}}" data-tip="{{c.company}}: {{c.lines}} marked lines">{{ c.company if (100*c.lines/cpt_total) >= 9 else "" }}</i>{% endfor %}
  </div>
  <details class="repo-details"><summary>Top authors of assistant-marked code ({{cpt_people|length}})</summary>
    <div style="overflow-x:auto;margin-top:8px">{{ data_table([
      {'label':'Person', 'kind':'text', 'key':'login'},
      {'label':'Name', 'kind':'text', 'key':'name'},
      {'label':'Company', 'kind':'text', 'key':'company'},
      {'label':'Marked lines', 'kind':'loc', 'key':'lines'},
    ], cpt_people, cap=30) }}</div>
  </details>
  {% endif %}
  <p class="conc"><b>Generated specs</b> = <code>studio: true</code> frontmatter; <b>marked specs (cpt-IDs)</b> = spec docs referencing <code>cpt-…</code> artifact IDs; <b>assistant code markers</b> = <code>@cpt-…</code> traceability annotations. Code-marker lines are blame-attributed to their author (full-history clones). Patterns in <code>config.yaml → studio_provenance</code>. Covers only cloned repos (your-org); company-internal repos need telemetry.</p>
</div>
</div>
{% endif %}

{% if gears_usage.markers %}
<div class="mode-section" data-modes="fabric all">
<h2 id="gears-usage">Gears framework — usage <span class="alltime-tag">all-time</span></h2>
<div class="card">
  <p class="hint">Repos that <b>depend on</b> Gears (vs the gears-* core repos, which are excluded as providers): frontend <code>@example-frontend/*</code> packages and Rust <code>example-crate-*</code> crates, found in full content.</p>
  <div class="mini">
    <div class="m"><div class="mv">{{ gears_usage.by_repo|length }}</div><div class="ml">repos using Gears</div></div>
    {% for m in gears_usage.markers %}
    <div class="m"><div class="mv">{{gears_usage.totals[m].files}}</div><div class="ml">{{m}} — files ({{gears_usage.totals[m].lines}} lines)</div></div>
    {% endfor %}
  </div>
  <div class="card" style="overflow-x:auto;border:none;padding:0;margin-top:10px"><table class="dt">
    <tr><th class="sortable">Repo (uses gears)</th>{% for m in gears_usage.markers %}{% set pr=(gears_usage.precision or {}).get(m,'exact') %}<th class="sortable">{{m}} <span class="prec {{pr}}">{{pr}}</span> (files / lines)</th>{% endfor %}</tr>
    {% for repo, vals in gears_usage.by_repo.items() %}
    <tr><td data-sort="{{ repo.split("/")[-1]|e }}">{{ repo.split("/")[-1] }}</td>
      {% for m in gears_usage.markers %}<td data-sort="{{ vals[m].files if vals.get(m) else 0 }}">{{ vals[m].files if vals.get(m) else 0 }} / {{ vals[m].lines if vals.get(m) else 0 }}</td>{% endfor %}
    </tr>
    {% endfor %}
    {% if not gears_usage.by_repo %}<tr><td colspan="{{gears_usage.markers|length + 1}}" class="muted">No gears dependencies found in cloned repos.</td></tr>{% endif %}
  </table></div>
  <p class="conc">Markers in <code>config.yaml → gears_usage.markers</code>. Provider repos (example-core / example-frontend / example-csharp) are excluded. This is "who builds on Gears" — the consumption side of the platform-vs-app lens, by content not guesswork.</p>
</div>
</div>
{% endif %}

{% for tname, t in fabric_trackers.items() %}{% if t.markers %}
<div class="mode-section" data-modes="fabric all">
<h2>{{tname}} <span class="alltime-tag">all-time</span></h2>
<div class="card">
  <div class="mini">
    <div class="m"><div class="mv">{{ t.by_repo|length }}</div><div class="ml">repos</div></div>
    {% for m in t.markers %}<div class="m"><div class="mv">{{t.totals[m].files}}</div><div class="ml">{{m}} — files</div></div>{% endfor %}
  </div>
  <div class="card" style="overflow-x:auto;border:none;padding:0;margin-top:10px"><table class="dt">
    <tr><th class="sortable">Repo</th>{% for m in t.markers %}{% set pr=(t.precision or {}).get(m,'exact') %}<th class="sortable">{{m}} <span class="prec {{pr}}">{{pr}}</span> (files / lines)</th>{% endfor %}</tr>
    {% for repo, vals in t.by_repo.items() %}
    <tr><td data-sort="{{ repo.split("/")[-1]|e }}">{{ repo.split("/")[-1] }}</td>
      {% for m in t.markers %}<td data-sort="{{ vals[m].files if vals.get(m) else 0 }}">{{ vals[m].files if vals.get(m) else 0 }} / {{ vals[m].lines if vals.get(m) else 0 }}</td>{% endfor %}
    </tr>
    {% endfor %}
    {% if not t.by_repo %}<tr><td colspan="{{t.markers|length + 1}}" class="muted">No matches in cloned repos.</td></tr>{% endif %}
  </table></div>
</div>
</div>
{% endif %}{% endfor %}

