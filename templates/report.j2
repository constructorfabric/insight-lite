<p class="foot">Definitions — <b>Contributing to Fabric</b>: any commit, PR, spec edit, bug or user story in <b>any</b> repo of the org (apps included).
  <b>Using, not contributing back</b>: forked an org repo but made zero contribution to any org repo in the window.
  <b>Specs</b>: commits touching markdown under <code>specs/</code> directories (templates &amp; vendored SDLC framework excluded — see <code>config.yaml</code>).
  Platform-vs-app below is a "where effort goes" breakdown, not the contribute/use line.
  GitHub-only data; passive consumption beyond forks/stars is not observable.</p>

<script>
(function(){
  // Portal-driven period filter: every filterable panel is a [data-period-panel]
  // region. The build-time content is all-time; changing period fetches a fragment
  // from /api/period and swaps each region's innerHTML. Results are cached per
  // period; 'all' restores the build-time snapshot; offline falls back to all-time.
  var PERIOD_LABELS = {'7d':'7 days','30d':'30 days','90d':'90 days','365d':'1 year','all':'{{ all_label }}'};
  var PERIOD_DAYS = {'7d':7,'30d':30,'90d':90,'365d':365};
  // Build API URLs against location.origin (never carries userinfo). A relative
  // fetch resolves against the document URL, and when the portal is opened behind
  // basic-auth with credentials in the URL (http://user:pass@host/…), the resolved
  // URL keeps the userinfo — which fetch() rejects ("URL that includes credentials").
  // ref-counted top progress bar: every portal fetch goes through _api, so this
  // covers period/slice/trend/delivery/flow/person/drill loads uniformly. The count
  // avoids flicker when several fetches overlap (a period switch fires 3+ at once).
  var _loading = 0;
  function _loadbar(on){ var b = document.getElementById('loadbar');
    if(b) b.classList.toggle('on', !!on); }
  function _loadStart(){ _loading++; _loadbar(true); }
  function _loadEnd(){ _loading = Math.max(0, _loading - 1); if(_loading === 0) _loadbar(false); }
  function _api(path){
    _loadStart();
    var p = fetch(location.origin + path);
    // settle the counter whether the fetch resolves or rejects (no .finally: older WebViews)
    p.then(_loadEnd, _loadEnd);
    return p;
  }
  var _panels = {};
  Array.prototype.forEach.call(document.querySelectorAll('[data-period-panel]'), function(el){
    _panels[el.getAttribute('data-period-panel')] = el; });
  var _snapAll = {};
  Object.keys(_panels).forEach(function(k){ _snapAll[k] = _panels[k].innerHTML; });
  var _cache = {all: _snapAll};
  var _offline = false;
  // Idempotent Vega-Lite hydrator: finds server-rendered .vl-panel containers
  // (a <script type="application/json" class="vl-spec"> holding the spec) and
  // mounts them with vegaEmbed. Safe to call repeatedly / broadly (document-wide)
  // after any fragment swap — el.dataset.done guards against re-mounting.
  function hydrateVega(root){
    (root || document).querySelectorAll('.vl-panel').forEach(function(el){
      if (el.dataset.done) return;
      var s = el.querySelector('script.vl-spec');
      if (!s || !window.vegaEmbed) return;
      var spec; try { spec = JSON.parse(s.textContent); } catch(e){ return; }
      function tryEmbed(){
        if (el.dataset.done) return true;
        if (!el.clientWidth) return false;   // not laid out yet (e.g. hidden tab) — wait for width
        el.dataset.done = "1";
        vegaEmbed(el, spec, {actions:false, renderer:'svg', tooltip:true})
          .catch(function(){ el.innerHTML = '<div class="dp-err">chart failed</div>'; });
        return true;
      }
      if (!tryEmbed() && window.ResizeObserver){
        var ro = new ResizeObserver(function(){ if (tryEmbed()) ro.disconnect(); });
        ro.observe(el);
      }
    });
  }
  function _applyMap(m){ Object.keys(m).forEach(function(k){ if(_panels[k]) _panels[k].innerHTML = m[k]; }); dimZeros(); hydrateVega(document); }
  // fade zero / no-data cells so real values stand out; re-run after panel swaps
  function dimZeros(){
    Array.prototype.forEach.call(document.querySelectorAll('td'), function(td){
      if(td.children.length) return;
      var t = td.textContent.trim();
      td.classList.toggle('z', /^0(\.0+)?\s*%?$/.test(t) || /^0\s*\/\s*0$/.test(t) || t === '—');
    });
  }
  function _parseFragment(html){
    var t = document.createElement('div'); t.innerHTML = html; var m = {};
    Array.prototype.forEach.call(t.querySelectorAll('[data-period-panel]'), function(el){
      m[el.getAttribute('data-period-panel')] = el.innerHTML; });
    return m;
  }
  function _setChips(p){ Array.prototype.forEach.call(document.querySelectorAll('.pchip[data-pchip]'), function(c){
    c.classList.toggle('active', c.getAttribute('data-pchip') === p); }); }
  function _setTags(txt){ Array.prototype.forEach.call(document.querySelectorAll('[data-period-tag]'), function(t){
    t.textContent = txt || ''; }); }
  function _note(msg){ var n = document.getElementById('period-msg'); if(n) n.textContent = msg || ''; }
  function _fmtDay(s){
    if(!s) return '';
    try { return new Date(s + 'T00:00:00').toLocaleDateString(undefined,
      {day:'numeric', month:'short', year:'numeric'}); } catch(e){ return s; }
  }
  // The active period must ALWAYS be visible: a preset lights its segment; a custom
  // range shows the actual dates ON the Custom button (which stays highlighted).
  function _setCustBtn(on, from, to){
    var b = document.getElementById('pcustbtn'); if(!b) return;
    b.classList.toggle('on', !!on);
    b.textContent = on ? ((_fmtDay(from) || '…') + ' → ' + (_fmtDay(to) || 'today')) : 'Custom…';
  }
  function toggleCustom(){
    var c = document.getElementById('period-custom'); if(!c) return;
    c.hidden = !c.hidden;
    if(!c.hidden){ var f = document.getElementById('pfrom'); if(f) f.focus(); }
  }
  window.toggleCustom = toggleCustom;
  // Active period query + tag, so the slice filter can re-fetch the current period.
  var _curQS = 'from=2008-01-01', _curTag = PERIOD_LABELS['all'], _scope = '',
      _urlPeriod = {p: 'all'}, _urlTrend = {}, _pendingTrendOnce = null;
  // Deep-link: mirror the view (period, slice, person, Trend breakdown/granularity,
  // and any open drill) into the URL query string so a copied link reproduces exactly
  // what the sender sees. The tab stays in the #hash. replaceState (no new history
  // entries) — like the tab routing already does.
  function _syncURL(){
    try {
      var qp = [];
      if(_urlPeriod.p && _urlPeriod.p !== 'all') qp.push('p=' + _urlPeriod.p);
      else if(_urlPeriod.from || _urlPeriod.to){
        if(_urlPeriod.from) qp.push('from=' + _urlPeriod.from);
        if(_urlPeriod.to) qp.push('to=' + _urlPeriod.to);
      }
      if(_scope) qp.push('slice=' + encodeURIComponent(_scope));
      var pv = (document.getElementById('person-select') || {}).value;
      if(pv) qp.push('person=' + encodeURIComponent(pv));
      if(_urlTrend.dim && _urlTrend.dim !== 'company') qp.push('tdim=' + _urlTrend.dim);
      if(_urlTrend.gran && _urlTrend.gran !== 'auto') qp.push('tgran=' + _urlTrend.gran);
      var cd = window.__curDrill;
      if(cd){ try { qp.push('drill=' + encodeURIComponent(JSON.stringify(cd))); } catch(e){} }
      history.replaceState(null, '',
        location.pathname + (qp.length ? '?' + qp.join('&') : '') + (location.hash || ''));
    } catch(e){}
  }
  window.__syncURL = _syncURL;   // so the (separate) drill IIFE can sync too
  function _applyPendingTrend(){
    if(!_pendingTrendOnce) return;
    var t = _pendingTrendOnce; _pendingTrendOnce = null;
    _urlTrend = {gran: t.gran, dim: t.dim};
    _refreshTrend(t.gran, t.dim); _syncURL();
  }
  function setPeriod(p){
    if(_offline && p !== 'all'){ return; }
    _urlPeriod = {p: p}; _urlTrend = {};   // trend resets to auto/company on the new window
    _setChips(p); _setCustBtn(false); _setTags(PERIOD_LABELS[p] || p);
    _personQS = (p === 'all') ? 'from=2008-01-01' : ('days=' + PERIOD_DAYS[p]); _syncPerson();
    _curQS = _personQS; _curTag = PERIOD_LABELS[p] || p;
    try { localStorage.setItem('fabricReportPeriod', p); } catch(e){}
    _syncURL(); refreshMain(); refreshDelivery(); refreshFlow();
  }
  window.setPeriod = setPeriod;
  // Global slice: scope every windowed panel to a repo subset (org/element/repo).
  window.setScope = function(v){ _scope = v || ''; _urlTrend = {}; _syncURL(); refreshMain(); refreshDelivery(); refreshFlow(); };
  // Trend controls: re-render only the trend panel for the current window + slice at a
  // chosen granularity and breakdown dimension. The other control's value is read from
  // the panel's active button, so state can't drift; period/slice changes reset both
  // (the /api/period fragment and baked snapshot render auto + company).
  function _trendActive(attr, dflt){
    var b = document.querySelector('[data-period-panel="trend"] [' + attr + '].active');
    return b ? b.getAttribute(attr) : dflt;
  }
  function _refreshTrend(gran, dim){
    if(!document.querySelector('[data-period-panel="trend"]')) return;
    _api('/api/trend?' + _curQS + (_scope ? '&scope=' + encodeURIComponent(_scope) : '')
         + '&gran=' + encodeURIComponent(gran) + '&dim=' + encodeURIComponent(dim))
      .then(function(r){ return r.json(); }).then(function(s){
        if(s && s.ok && s.html){ _applyMap(_parseFragment(s.html)); hydrateVega(document); }
      }).catch(function(){});
  }
  window.setTrendGran = function(g){ var dim = _trendActive('data-trenddim', 'company');
    _urlTrend = {gran: g || 'auto', dim: dim}; _refreshTrend(g || 'auto', dim); _syncURL(); };
  window.setTrendDim = function(d){ var gran = _trendActive('data-gran', 'auto');
    _urlTrend = {gran: gran, dim: d || 'company'}; _refreshTrend(gran, d || 'company'); _syncURL(); };
  function refreshMain(){
    // all-time + whole org is exactly the build-time snapshot — no round-trip
    if(_curQS === 'from=2008-01-01' && !_scope){ _applyMap(_snapAll); _setTags(_curTag); _note(''); _applyPendingTrend(); return; }
    var key = _curQS + '|' + _scope;
    if(_cache[key]){ _applyMap(_cache[key]); _setTags(_curTag); _note(''); _applyPendingTrend(); return; }
    _fetchPeriod(_curQS, key, _curTag);
  }
  function _fetchPeriod(qs, key, tagText){
    _note('Loading…');
    _api('/api/period?' + qs + (_scope ? '&scope=' + encodeURIComponent(_scope) : ''))
      .then(function(r){ return r.json(); }).then(function(s){
      if(s && s.ok && s.html){
        var m = _parseFragment(s.html); if(key) _cache[key] = m; _applyMap(m);
        _setTags(tagText || s.range || ''); _note(''); _applyPendingTrend();
      } else { _fallback(); }
    }).catch(function(){ _fallback(); });
  }
  function _fallback(){
    _offline = true;
    _note('Period filtering needs the portal — showing all-time.');
    _setChips('all'); _setTags(PERIOD_LABELS['all']); _applyMap(_snapAll);
    try { localStorage.setItem('fabricReportPeriod', 'all'); } catch(e){}
  }
  function applyRange(){
    var f = (document.getElementById('pfrom') || {}).value || '';
    var t = (document.getElementById('pto') || {}).value || '';
    if(!f && !t){ return; }
    if(f && t && f > t){ alert('"from" is after "to"'); return; }
